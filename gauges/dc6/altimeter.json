{
  "format": 1,
  "name": "DC-6 Altimeter",
  "author": "FIPinator 3000",
  "license": "FREE and open source (AGPL-3.0): free to use, change, share and fork.",
  "description": "Three-hand altimeter in DC-6 style: long hand 100 ft per digit (1000 ft per turn), wide hand 1000 ft per digit, thin hand 10,000 ft per digit, and a pressure window in inches of mercury.",
  "canvas": { "width": 320, "height": 240, "background": "#5A6064" },
  "center": [160, 120],
  "font": "../../assets/fonts/BarlowCondensed-Medium.ttf",
  "values": {
    "alt": { "sim": "INDICATED ALTITUDE", "unit": "feet", "default": 7350 },
    "baro": { "sim": "KOHLSMAN SETTING HG", "unit": "inHg", "default": 29.92 }
  },
  "scales": {
    "h100": { "min": 0, "max": 1000, "startAngle": 0, "endAngle": 360, "wrap": true },
    "h1000": { "min": 0, "max": 10000, "startAngle": 0, "endAngle": 360, "wrap": true },
    "h10000": { "min": 0, "max": 100000, "startAngle": 0, "endAngle": 360, "wrap": true }
  },
  "controls": {
    "rightKnobClockwise": { "event": "KOHLSMAN_INC" },
    "rightKnobAnticlockwise": { "event": "KOHLSMAN_DEC" },
    "leftKnobClockwise": { "event": "KOHLSMAN_INC", "repeat": 10 },
    "leftKnobAnticlockwise": { "event": "KOHLSMAN_DEC", "repeat": 10 }
  },
  "layers": [
    { "type": "rect", "x": 40, "y": 0, "width": 240, "height": 240, "radius": 18, "fill": "#6C7378", "stroke": "#41474A", "strokeWidth": 1.5 },
    { "type": "screw", "x": 60, "y": 20, "kind": "slot" },
    { "type": "screw", "x": 260, "y": 20, "kind": "slot" },
    { "type": "screw", "x": 260, "y": 222, "kind": "slot" },
    { "type": "circle", "center": [62, 218], "r": 14, "fill": "#1C1C1C", "stroke": "#3A3A3A", "strokeWidth": 2 },

    { "type": "circle", "r": 115, "fillTop": "#303030", "fillBottom": "#0A0A0A", "stroke": "#2A2A2A", "strokeWidth": 1.2 },
    { "type": "circle", "r": 107, "fill": "#0B0B0B", "stroke": "#202020", "strokeWidth": 3 },

    { "type": "rect", "x": 205, "y": 111, "width": 46, "height": 19, "radius": 2, "fill": "#151515", "stroke": "#3A3A3A", "strokeWidth": 1 },
    { "type": "text", "value": "baro", "format": "0.00", "x": 228, "y": 126, "size": 15, "color": "#E0B13C" },

    { "type": "ticks", "scale": "h100", "every": 20, "from": 0, "to": 980, "radius": 104, "length": 7, "width": 1.6, "color": "#F1EEE6" },
    { "type": "ticks", "scale": "h100", "every": 100, "from": 0, "to": 900, "radius": 104, "length": 14, "width": 3, "color": "#F1EEE6" },
    { "type": "labels", "scale": "h100", "every": 100, "from": 0, "to": 900, "divideBy": 100, "radius": 78, "size": 30, "color": "#F1EEE6" },

    { "type": "text", "text": "100", "x": 134, "y": 40, "size": 9, "color": "#C9C4B8" },
    { "type": "text", "text": "FEET", "x": 188, "y": 40, "size": 9, "color": "#C9C4B8" },
    { "type": "text", "text": "1000 FEET", "x": 160, "y": 72, "size": 9, "color": "#C9C4B8" },
    { "type": "text", "text": "10000 FEET", "x": 160, "y": 83, "size": 9, "color": "#C9C4B8" },
    { "type": "text", "text": "ALTITUDE", "x": 160, "y": 103, "size": 15, "color": "#E8E5DC" },

    { "type": "needle", "scale": "h10000", "value": "alt", "length": 100, "tail": 0, "width": 1.4, "color": "#E8E5DC", "tailColor": "#E8E5DC", "shadow": true },
    { "type": "needle", "scale": "h1000", "value": "alt", "length": 55, "tail": 10, "width": 8, "color": "#E8E5DC", "tailColor": "#161616", "shadow": true },
    { "type": "needle", "scale": "h100", "value": "alt", "length": 94, "tail": 20, "width": 4, "color": "#F4F2EC", "tailColor": "#161616", "shadow": true },
    { "type": "hub", "r": 8, "fill": "#1A1A1A", "stroke": "#5A5A5A" },
    { "type": "glare", "r": 106, "opacity": 0.18 }
  ]
}
