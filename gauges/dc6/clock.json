{
  "format": 1,
  "name": "DC-6 Clock",
  "author": "FIPinator 3000",
  "description": "Panel clock showing the sim\u0027s local time.",
  "canvas": {
    "width": 320,
    "height": 240,
    "background": "#5A6064"
  },
  "center": [
    160,
    120
  ],
  "font": "../../assets/fonts/BarlowCondensed-Medium.ttf",
  "values": {
    "t": {
      "sim": "LOCAL TIME",
      "unit": "seconds",
      "default": 36925
    },
    "h": {
      "expr": "t / 3600 % 12"
    },
    "m": {
      "expr": "t / 60 % 60"
    },
    "s": {
      "expr": "t % 60"
    }
  },
  "scales": {
    "hr": {
      "min": 0,
      "max": 12,
      "startAngle": 0,
      "endAngle": 360,
      "wrap": true
    },
    "min": {
      "min": 0,
      "max": 60,
      "startAngle": 0,
      "endAngle": 360,
      "wrap": true
    }
  },
  "layers": [
    {
      "type": "rect",
      "x": 40,
      "y": 0,
      "width": 240,
      "height": 240,
      "radius": 18,
      "fill": "#6C7378",
      "stroke": "#41474A",
      "strokeWidth": 1.5
    },
    {
      "type": "screw",
      "x": 60,
      "y": 20,
      "kind": "boss"
    },
    {
      "type": "screw",
      "x": 260,
      "y": 20,
      "kind": "boss"
    },
    {
      "type": "screw",
      "x": 58,
      "y": 222,
      "kind": "slot"
    },
    {
      "type": "screw",
      "x": 262,
      "y": 222,
      "kind": "slot"
    },
    {
      "type": "circle",
      "r": 115,
      "fillTop": "#303030",
      "fillBottom": "#0A0A0A",
      "stroke": "#2A2A2A",
      "strokeWidth": 1.2
    },
    {
      "type": "circle",
      "r": 107,
      "fill": "#0B0B0B",
      "stroke": "#202020",
      "strokeWidth": 3
    },
    {
      "type": "ticks",
      "scale": "min",
      "every": 1,
      "from": 0,
      "to": 59,
      "radius": 98.48,
      "length": 6,
      "width": 1.3,
      "color": "#EDEAE2"
    },
    {
      "type": "ticks",
      "scale": "min",
      "every": 5,
      "from": 0,
      "to": 55,
      "radius": 98.48,
      "length": 14,
      "width": 3,
      "color": "#EDEAE2"
    },
    {
      "type": "labels",
      "scale": "hr",
      "every": 1,
      "from": 1,
      "to": 12,
      "radius": 75.75,
      "size": 22,
      "color": "#EDEAE2"
    },
    {
      "type": "text",
      "text": "LOCAL TIME",
      "x": 160,
      "y": 159.77,
      "size": 9,
      "color": "#D8D4CA"
    },
    {
      "type": "needle",
      "scale": "hr",
      "value": "h",
      "length": 49.24,
      "tail": 11.36,
      "width": 5,
      "color": "#F4F2EC",
      "tailColor": "#F4F2EC",
      "shadow": true
    },
    {
      "type": "needle",
      "scale": "min",
      "value": "m",
      "length": 81.43,
      "tail": 13.26,
      "width": 3.6,
      "color": "#F4F2EC",
      "tailColor": "#F4F2EC",
      "shadow": true
    },
    {
      "type": "needle",
      "scale": "min",
      "value": "s",
      "length": 89.01,
      "tail": 18.94,
      "width": 1.3,
      "color": "#D3362B",
      "tailColor": "#D3362B",
      "shadow": true
    },
    {
      "type": "hub",
      "r": 6,
      "fill": "#141414",
      "stroke": "#4A4A4A"
    },
    {
      "type": "glare",
      "r": 106,
      "opacity": 0.18
    }
  ],
  "license": "FREE and open source (AGPL-3.0): free to use, change, share and fork."
}
