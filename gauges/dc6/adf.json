{
  "format": 1,
  "name": "DC-6 ADF",
  "author": "FIPinator 3000",
  "description": "Fixed-card ADF: needle to the beacon, card turned with the knobs.",
  "canvas": {
    "width": 320,
    "height": 240,
    "background": "#5A6064"
  },
  "center": [
    160,
    120
  ],
  "font": "../../assets/fonts/BarlowCondensed-Medium.ttf",
  "values": {
    "brg": {
      "sim": "ADF RADIAL:1",
      "unit": "degrees",
      "default": 35
    },
    "sig": {
      "sim": "ADF SIGNAL:1",
      "unit": "number",
      "default": 1
    },
    "card": {
      "sim": "ADF CARD",
      "unit": "degrees",
      "default": 0
    },
    "needle": {
      "expr": "choose(sig, brg, 90)"
    }
  },
  "scales": {
    "card": {
      "min": 0,
      "max": 360,
      "startAngle": 0,
      "endAngle": -360,
      "wrap": true
    },
    "dial": {
      "min": 0,
      "max": 360,
      "startAngle": 0,
      "endAngle": 360,
      "wrap": true
    }
  },
  "layers": [
    {
      "type": "rect",
      "x": 40,
      "y": 0,
      "width": 240,
      "height": 240,
      "radius": 18,
      "fill": "#6C7378",
      "stroke": "#41474A",
      "strokeWidth": 1.5
    },
    {
      "type": "screw",
      "x": 60,
      "y": 20,
      "kind": "boss"
    },
    {
      "type": "screw",
      "x": 260,
      "y": 20,
      "kind": "boss"
    },
    {
      "type": "screw",
      "x": 58,
      "y": 222,
      "kind": "slot"
    },
    {
      "type": "screw",
      "x": 262,
      "y": 222,
      "kind": "slot"
    },
    {
      "type": "circle",
      "r": 115,
      "fillTop": "#303030",
      "fillBottom": "#0A0A0A",
      "stroke": "#2A2A2A",
      "strokeWidth": 1.2
    },
    {
      "type": "circle",
      "r": 107,
      "fill": "#0B0B0B",
      "stroke": "#202020",
      "strokeWidth": 3
    },
    {
      "type": "group",
      "rotate": {
        "value": "card",
        "scale": "card"
      },
      "layers": [
        {
          "type": "ticks",
          "scale": "dial",
          "every": 5,
          "from": 0,
          "to": 355,
          "radius": 98.48,
          "length": 7,
          "width": 1.4,
          "color": "#EDEAE2"
        },
        {
          "type": "ticks",
          "scale": "dial",
          "every": 10,
          "from": 0,
          "to": 350,
          "radius": 98.48,
          "length": 13,
          "width": 2.4,
          "color": "#EDEAE2"
        },
        {
          "type": "labels",
          "scale": "dial",
          "every": 30,
          "from": 0,
          "to": 330,
          "radius": 77.65,
          "size": 19,
          "color": "#EDEAE2",
          "orient": "radial",
          "texts": {
            "0": "N",
            "30": "3",
            "60": "6",
            "90": "E",
            "120": "12",
            "150": "15",
            "180": "S",
            "210": "21",
            "240": "24",
            "270": "W",
            "300": "30",
            "330": "33"
          }
        }
      ]
    },
    {
      "type": "ticks",
      "scale": "dial",
      "at": [
        0
      ],
      "radius": 106.05,
      "length": 14,
      "width": 12,
      "shape": "triangle",
      "color": "#E8862A"
    },
    {
      "type": "ticks",
      "scale": "dial",
      "at": [
        45,
        90,
        135,
        180,
        225,
        270,
        315
      ],
      "radius": 106.05,
      "length": 8,
      "width": 8,
      "shape": "triangle",
      "color": "#EDEAE2"
    },
    {
      "type": "text",
      "text": "ADF",
      "x": 160,
      "y": 157.88,
      "size": 12,
      "color": "#D8D4CA"
    },
    {
      "type": "needle",
      "scale": "dial",
      "value": "needle",
      "style": "arrow",
      "length": 85.22,
      "tail": 77.65,
      "width": 2.6,
      "color": "#E8D23A",
      "shadow": true
    },
    {
      "type": "hub",
      "r": 7,
      "fill": "#141414",
      "stroke": "#4A4A4A"
    },
    {
      "type": "glare",
      "r": 106,
      "opacity": 0.18
    }
  ],
  "controls": {
    "rightKnobClockwise": {
      "event": "ADF_CARD_INC"
    },
    "rightKnobAnticlockwise": {
      "event": "ADF_CARD_DEC"
    },
    "leftKnobClockwise": {
      "event": "ADF_CARD_INC",
      "repeat": 10
    },
    "leftKnobAnticlockwise": {
      "event": "ADF_CARD_DEC",
      "repeat": 10
    }
  },
  "license": "FREE and open source (AGPL-3.0): free to use, change, share and fork."
}
