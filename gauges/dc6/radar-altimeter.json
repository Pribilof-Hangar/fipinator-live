{
  "format": 1,
  "name": "DC-6 Radar altimeter",
  "author": "FIPinator 3000",
  "description": "Radar altimeter 0-2,500 ft with decision-height bug and DH light. Knobs set the decision height.",
  "canvas": {
    "width": 320,
    "height": 240,
    "background": "#5A6064"
  },
  "center": [
    160,
    120
  ],
  "font": "../../assets/fonts/BarlowCondensed-Medium.ttf",
  "values": {
    "ra": {
      "sim": "RADIO HEIGHT",
      "unit": "feet",
      "default": 180
    },
    "dh": {
      "sim": "DECISION HEIGHT",
      "unit": "feet",
      "default": 200
    },
    "dh_light": {
      "expr": "choose(dh - ra, 0, 400)"
    }
  },
  "scales": {
    "ra": {
      "points": [
        [
          0,
          10
        ],
        [
          100,
          40
        ],
        [
          200,
          70
        ],
        [
          300,
          95
        ],
        [
          400,
          120
        ],
        [
          500,
          145
        ],
        [
          1000,
          195
        ],
        [
          1500,
          225
        ],
        [
          2000,
          250
        ],
        [
          2500,
          275
        ]
      ]
    },
    "dial": {
      "min": 0,
      "max": 360,
      "startAngle": 0,
      "endAngle": 360,
      "wrap": true
    },
    "px": {
      "min": -1000,
      "max": 1000,
      "startAngle": -1000,
      "endAngle": 1000
    }
  },
  "layers": [
    {
      "type": "rect",
      "x": 40,
      "y": 0,
      "width": 240,
      "height": 240,
      "radius": 18,
      "fill": "#6C7378",
      "stroke": "#41474A",
      "strokeWidth": 1.5
    },
    {
      "type": "screw",
      "x": 60,
      "y": 20,
      "kind": "boss"
    },
    {
      "type": "screw",
      "x": 260,
      "y": 20,
      "kind": "boss"
    },
    {
      "type": "screw",
      "x": 58,
      "y": 222,
      "kind": "slot"
    },
    {
      "type": "screw",
      "x": 262,
      "y": 222,
      "kind": "slot"
    },
    {
      "type": "circle",
      "r": 115,
      "fillTop": "#303030",
      "fillBottom": "#0A0A0A",
      "stroke": "#2A2A2A",
      "strokeWidth": 1.2
    },
    {
      "type": "circle",
      "r": 107,
      "fill": "#0B0B0B",
      "stroke": "#202020",
      "strokeWidth": 3
    },
    {
      "type": "ticks",
      "scale": "ra",
      "every": 20,
      "from": 0,
      "to": 500,
      "radius": 98.48,
      "length": 7,
      "width": 1.4,
      "color": "#EDEAE2"
    },
    {
      "type": "ticks",
      "scale": "ra",
      "every": 100,
      "from": 500,
      "to": 2500,
      "radius": 98.48,
      "length": 7,
      "width": 1.4,
      "color": "#EDEAE2"
    },
    {
      "type": "ticks",
      "scale": "ra",
      "at": [
        0,
        100,
        200,
        300,
        400,
        500,
        1000,
        1500,
        2000,
        2500
      ],
      "radius": 98.48,
      "length": 15,
      "width": 2.8,
      "color": "#EDEAE2"
    },
    {
      "type": "labels",
      "scale": "ra",
      "at": [
        0,
        100,
        200,
        300,
        400,
        500,
        1000,
        1500,
        2000,
        2500
      ],
      "divideBy": 100,
      "radius": 75.75,
      "size": 20,
      "color": "#EDEAE2"
    },
    {
      "type": "text",
      "text": "RADAR",
      "x": 127.81,
      "y": 112.42,
      "size": 12,
      "color": "#D8D4CA"
    },
    {
      "type": "text",
      "text": "ALTITUDE",
      "x": 127.81,
      "y": 125.68,
      "size": 12,
      "color": "#D8D4CA"
    },
    {
      "type": "text",
      "text": "X 100 FEET",
      "x": 180.83,
      "y": 176.81,
      "size": 10,
      "color": "#D8D4CA"
    },
    {
      "type": "group",
      "rotate": {
        "value": "dh",
        "scale": "ra"
      },
      "layers": [
        {
          "type": "ticks",
          "scale": "dial",
          "at": [
            0
          ],
          "radius": 106.05,
          "length": 14,
          "width": 13,
          "shape": "triangle",
          "color": "#E8862A"
        }
      ]
    },
    {
      "type": "group",
      "moveX": {
        "value": "dh_light",
        "scale": "px"
      },
      "layers": [
        {
          "type": "circle",
          "r": 11,
          "center": [
            127.81,
            152.19
          ],
          "fillTop": "#FFE9A0",
          "fillBottom": "#E0901A",
          "stroke": "#000000"
        },
        {
          "type": "text",
          "text": "DH",
          "x": 127.81,
          "y": 156.19,
          "size": 11,
          "color": "#1A1A1A"
        }
      ]
    },
    {
      "type": "needle",
      "scale": "ra",
      "value": "ra",
      "length": 89.01,
      "tail": 13.64,
      "width": 4.2,
      "color": "#F4F2EC",
      "tailColor": "#161616",
      "shadow": true
    },
    {
      "type": "hub",
      "r": 8,
      "fill": "#141414",
      "stroke": "#4A4A4A"
    },
    {
      "type": "glare",
      "r": 106,
      "opacity": 0.18
    }
  ],
  "controls": {
    "rightKnobClockwise": {
      "event": "INCREASE_DECISION_HEIGHT"
    },
    "rightKnobAnticlockwise": {
      "event": "DECREASE_DECISION_HEIGHT"
    },
    "leftKnobClockwise": {
      "event": "INCREASE_DECISION_HEIGHT",
      "repeat": 10
    },
    "leftKnobAnticlockwise": {
      "event": "DECREASE_DECISION_HEIGHT",
      "repeat": 10
    }
  },
  "license": "FREE and open source (AGPL-3.0): free to use, change, share and fork."
}
