{
  "format": 1,
  "name": "DC-6 RMI (VOR 2 + ADF 1)",
  "author": "FIPinator 3000",
  "license": "FREE and open source (AGPL-3.0): free to use, change, share and fork.",
  "description": "Radio magnetic indicator in DC-6 style: compass card turning with heading, single-line needle pointing to the VOR 2 station (VOR 1 / NAV 1 drives the course/ILS gauge), double-line needle pointing to the ADF 1 station. Each needle rests at 3 o'clock with no signal. Orange heading bug on the card shows the autopilot heading; the knobs move it (right 1 degree, left 10 degrees per click); its setting also shows as 3 digits in the upper right.",
  "canvas": { "width": 320, "height": 240, "background": "#5A6064" },
  "center": [160, 120],
  "font": "../../assets/fonts/BarlowCondensed-Medium.ttf",
  "values": {
    "heading": { "sim": "PLANE HEADING DEGREES MAGNETIC", "unit": "degrees", "default": 292 },
    "vor2_radial": { "sim": "NAV RADIAL:2", "unit": "degrees", "default": 160 },
    "vor2_signal": { "sim": "NAV HAS NAV:2", "unit": "bool", "default": 1 },
    "adf1_bearing": { "sim": "ADF RADIAL:1", "unit": "degrees", "default": 320 },
    "adf1_signal": { "sim": "ADF SIGNAL:1", "unit": "number", "default": 1 },
    "vor2_needle": { "expr": "choose(vor2_signal, wrap360(vor2_radial + 180 - heading), 90)" },
    "adf1_needle": { "expr": "choose(adf1_signal, adf1_bearing, 90)" },
    "hdg_bug": { "sim": "AUTOPILOT HEADING LOCK DIR", "unit": "degrees", "default": 310 },
    "hdg_display": { "expr": "wrap360(hdg_bug + 0.5 - (hdg_bug + 0.5) % 1)" }
  },
  "scales": {
    "card": { "min": 0, "max": 360, "startAngle": 0, "endAngle": -360 },
    "dial": { "min": 0, "max": 360, "startAngle": 0, "endAngle": 360, "wrap": true }
  },
  "controls": {
    "rightKnobClockwise": { "event": "HEADING_BUG_INC" },
    "rightKnobAnticlockwise": { "event": "HEADING_BUG_DEC" },
    "leftKnobClockwise": { "event": "HEADING_BUG_INC", "repeat": 10 },
    "leftKnobAnticlockwise": { "event": "HEADING_BUG_DEC", "repeat": 10 }
  },
  "layers": [
    { "type": "rect", "x": 40, "y": 0, "width": 240, "height": 240, "radius": 18, "fill": "#6C7378", "stroke": "#41474A", "strokeWidth": 1.5 },
    { "type": "screw", "x": 60, "y": 20, "kind": "slot" },
    { "type": "screw", "x": 260, "y": 20, "kind": "slot" },
    { "type": "screw", "x": 58, "y": 222, "kind": "slot" },
    { "type": "screw", "x": 262, "y": 222, "kind": "slot" },

    { "type": "circle", "r": 115, "fillTop": "#303030", "fillBottom": "#0A0A0A", "stroke": "#2A2A2A", "strokeWidth": 1.2 },
    { "type": "circle", "r": 107, "fill": "#0B0B0B", "stroke": "#202020", "strokeWidth": 3 },

    { "type": "group", "rotate": { "value": "heading", "scale": "card" }, "layers": [
      { "type": "ticks", "scale": "dial", "every": 5, "from": 0, "to": 355, "radius": 97, "length": 6, "width": 1.3, "color": "#E3DA9E" },
      { "type": "ticks", "scale": "dial", "every": 10, "from": 0, "to": 350, "radius": 97, "length": 11, "width": 2, "color": "#E3DA9E" },
      { "type": "labels", "scale": "dial", "every": 30, "from": 0, "to": 330, "radius": 72, "size": 22, "color": "#E8E5DC", "orient": "radial", "divideBy": 10 },
      { "type": "group", "rotate": { "value": "hdg_bug", "scale": "dial" }, "layers": [
        { "type": "rect", "x": 145, "y": 21, "width": 11, "height": 16, "radius": 1.5, "fill": "#F07A2A", "stroke": "#5A2A0A", "strokeWidth": 1 },
        { "type": "rect", "x": 164, "y": 21, "width": 11, "height": 16, "radius": 1.5, "fill": "#F07A2A", "stroke": "#5A2A0A", "strokeWidth": 1 }
      ] }
    ] },

    { "type": "ticks", "scale": "dial", "every": 45, "from": 45, "to": 315, "radius": 106, "length": 8, "width": 9, "color": "#E0D3A8", "shape": "triangle" },
    { "type": "ticks", "scale": "dial", "at": [0], "radius": 107, "length": 13, "width": 14, "color": "#E0D3A8", "shape": "triangle" },

    { "type": "rect", "x": 190, "y": 60, "width": 46, "height": 24, "radius": 3, "fill": "#0E0E0E", "stroke": "#5A5A5A", "strokeWidth": 1.2 },
    { "type": "text", "value": "hdg_display", "format": "000", "x": 213, "y": 79, "size": 20, "color": "#F07A2A" },
    { "type": "needle", "scale": "dial", "value": "adf1_needle", "style": "doubleArrow", "length": 88, "tail": 76, "width": 1.8, "color": "#E8E5DC", "shadow": true },
    { "type": "needle", "scale": "dial", "value": "vor2_needle", "style": "arrow", "length": 92, "tail": 80, "width": 3.4, "color": "#E8C547", "shadow": true },
    { "type": "hub", "r": 7, "fill": "#1A1A1A", "stroke": "#5A5A5A" },

    { "type": "text", "text": "< VOR 2", "x": 48, "y": 236, "size": 10, "color": "#E8C547", "align": "left" },
    { "type": "text", "text": "ADF 1 >>", "x": 272, "y": 236, "size": 10, "color": "#C9C4B8", "align": "right" },
    { "type": "glare", "r": 106, "opacity": 0.16 }
  ]
}
