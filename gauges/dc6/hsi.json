{
  "format": 1,
  "name": "DC-6 HSI",
  "author": "FIPinator 3000",
  "description": "HSI: compass card, heading bug, course arrow with deviation bar, TO/FROM, glideslope scales on both sides, NAV flag, CRS and HDG readouts. Right knob: course. Left knob: heading bug.",
  "canvas": {
    "width": 320,
    "height": 240,
    "background": "#5A6064"
  },
  "center": [
    160,
    120
  ],
  "font": "../../assets/fonts/BarlowCondensed-Medium.ttf",
  "values": {
    "hdg": {
      "sim": "PLANE HEADING DEGREES MAGNETIC",
      "unit": "degrees",
      "default": 300
    },
    "bug": {
      "sim": "AUTOPILOT HEADING LOCK DIR",
      "unit": "degrees",
      "default": 280
    },
    "obs": {
      "sim": "NAV OBS:1",
      "unit": "degrees",
      "default": 240
    },
    "cdi": {
      "sim": "HSI CDI NEEDLE",
      "unit": "number",
      "default": 40
    },
    "gsi": {
      "sim": "HSI GSI NEEDLE",
      "unit": "number",
      "default": -30
    },
    "has_nav": {
      "sim": "NAV HAS NAV:1",
      "unit": "bool",
      "default": 1
    },
    "has_gs": {
      "sim": "NAV HAS GLIDE SLOPE:1",
      "unit": "bool",
      "default": 1
    },
    "tofrom": {
      "sim": "NAV TOFROM:1",
      "unit": "number",
      "default": 1
    },
    "gps_drives": {
      "sim": "GPS DRIVES NAV1",
      "unit": "bool",
      "default": 0
    },
    "nav_flag_shift": {
      "expr": "choose(has_nav \u002B gps_drives, 400, 0)"
    },
    "gs_hide": {
      "expr": "choose(has_gs, 0, 400)"
    },
    "to_shift": {
      "expr": "choose(0.5 - abs(tofrom - 1), 0, 400)"
    },
    "from_shift": {
      "expr": "choose(0.5 - abs(tofrom - 2), 0, 400)"
    }
  },
  "scales": {
    "card": {
      "min": 0,
      "max": 360,
      "startAngle": 0,
      "endAngle": -360,
      "wrap": true
    },
    "dial": {
      "min": 0,
      "max": 360,
      "startAngle": 0,
      "endAngle": 360,
      "wrap": true
    },
    "cdipx": {
      "min": -127,
      "max": 127,
      "startAngle": -42.61,
      "endAngle": 42.61
    },
    "gsipx": {
      "min": -127,
      "max": 127,
      "startAngle": -52,
      "endAngle": 52
    },
    "px": {
      "min": -1000,
      "max": 1000,
      "startAngle": -1000,
      "endAngle": 1000
    }
  },
