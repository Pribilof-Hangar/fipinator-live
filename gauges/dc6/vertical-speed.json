{
  "format": 1,
  "name": "DC-6 Vertical Speed",
  "author": "FIPinator 3000",
  "license": "FREE and open source (AGPL-3.0): free to use, change, share and fork.",
  "description": "Vertical speed indicator in DC-6 style, in thousands of feet per minute. Level flight points to 9 o'clock; climb turns clockwise, descent anticlockwise, to 2000 ft/min each way. Scale angles read from the sim's cockpit by eye; check against the PMDG DC-6.",
  "canvas": { "width": 320, "height": 240, "background": "#5A6064" },
  "center": [160, 120],
  "font": "../../assets/fonts/BarlowCondensed-Medium.ttf",
  "values": {
    "vs": { "sim": "VERTICAL SPEED", "unit": "feet per minute", "default": 0 }
  },
  "scales": {
    "vs": { "points": [[-2000, 97], [-1500, 127], [-1000, 165], [-500, 210], [0, 270], [500, 330], [1000, 375], [1500, 413], [2000, 443]] }
  },
  "layers": [
    { "type": "rect", "x": 40, "y": 0, "width": 240, "height": 240, "radius": 18, "fill": "#6C7378", "stroke": "#41474A", "strokeWidth": 1.5 },
    { "type": "screw", "x": 60, "y": 20, "kind": "slot" },
    { "type": "screw", "x": 260, "y": 20, "kind": "slot" },
    { "type": "screw", "x": 58, "y": 222, "kind": "slot" },
    { "type": "screw", "x": 262, "y": 222, "kind": "slot" },

    { "type": "circle", "r": 115, "fillTop": "#303030", "fillBottom": "#0A0A0A", "stroke": "#2A2A2A", "strokeWidth": 1.2 },
    { "type": "circle", "r": 107, "fill": "#0B0B0B", "stroke": "#202020", "strokeWidth": 3 },

    { "type": "ticks", "scale": "vs", "every": 100, "from": -2000, "to": 2000, "radius": 103, "length": 10, "width": 2, "color": "#F1EEE6" },
    { "type": "ticks", "scale": "vs", "every": 500, "from": -2000, "to": 2000, "radius": 103, "length": 18, "width": 3.4, "color": "#F1EEE6" },
    { "type": "labels", "scale": "vs", "at": [-2000, -1500, -1000, -500, 500, 1000, 1500, 2000], "radius": 74, "size": 24, "color": "#F1EEE6",
      "texts": { "-2000": "2", "-1500": "1.5", "-1000": "1", "-500": ".5", "500": ".5", "1000": "1", "1500": "1.5", "2000": "2" } },

    { "type": "text", "text": "CLIMB", "x": 168, "y": 100, "size": 15, "color": "#E8E5DC" },
    { "type": "text", "text": "THOUSAND FT. PER MINUTE", "x": 168, "y": 113, "size": 9, "color": "#C9C4B8" },
    { "type": "text", "text": "UP", "x": 98, "y": 82, "size": 11, "color": "#C9C4B8" },
    { "type": "text", "text": "DOWN", "x": 100, "y": 166, "size": 11, "color": "#C9C4B8" },

    { "type": "needle", "scale": "vs", "value": "vs", "length": 96, "tail": 14, "width": 3.5, "color": "#F4F2EC", "tailColor": "#161616", "shadow": true },
    { "type": "hub", "r": 9, "fill": "#1A1A1A", "stroke": "#5A5A5A" },
    { "type": "glare", "r": 106, "opacity": 0.18 }
  ]
}
