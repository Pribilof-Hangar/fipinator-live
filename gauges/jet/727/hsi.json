      "startAngle": -40.22,
      "endAngle": 40.22
    },
    "gsipx": {
      "min": -127,
      "max": 127,
      "startAngle": -52,
      "endAngle": 52
    },
    "px": {
      "min": -1000,
      "max": 1000,
      "startAngle": -1000,
      "endAngle": 1000
    }
  },
