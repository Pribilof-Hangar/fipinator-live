{
  "format": 1,
  "name": "727 HSI",
  "author": "FIPinator 3000",
  "description": "HSI with DME MILES and COURSE windows above the dial, like older airliner HSIs.",
  "canvas": {
    "width": 320,
    "height": 240,
    "background": "#66766C"
  },
  "center": [
    160,
    120
  ],
  "font": "../../../assets/fonts/BarlowCondensed-Medium.ttf",
  "values": {
    "hdg": {
      "sim": "PLANE HEADING DEGREES MAGNETIC",
      "unit": "degrees",
      "default": 300
    },
    "bug": {
      "sim": "AUTOPILOT HEADING LOCK DIR",
      "unit": "degrees",
      "default": 280
    },
    "obs": {
      "sim": "NAV OBS:1",
      "unit": "degrees",
      "default": 240
    },
    "cdi": {
      "sim": "HSI CDI NEEDLE",
      "unit": "number",
      "default": 40
    },
    "gsi": {
      "sim": "HSI GSI NEEDLE",
      "unit": "number",
      "default": -30
    },
    "has_nav": {
      "sim": "NAV HAS NAV:1",
      "unit": "bool",
      "default": 1
    },
    "has_gs": {
      "sim": "NAV HAS GLIDE SLOPE:1",
      "unit": "bool",
      "default": 1
    },
    "tofrom": {
      "sim": "NAV TOFROM:1",
      "unit": "number",
      "default": 1
    },
    "gps_drives": {
      "sim": "GPS DRIVES NAV1",
      "unit": "bool",
      "default": 0
    },
    "nav_flag_shift": {
      "expr": "choose(has_nav \u002B gps_drives, 400, 0)"
    },
    "gs_hide": {
      "expr": "choose(has_gs, 0, 400)"
    },
    "to_shift": {
      "expr": "choose(0.5 - abs(tofrom - 1), 0, 400)"
    },
    "from_shift": {
      "expr": "choose(0.5 - abs(tofrom - 2), 0, 400)"
    },
    "dme": {
      "sim": "NAV DME:1",
      "unit": "nautical miles",
      "default": 12
    }
  },
  "scales": {
    "card": {
      "min": 0,
      "max": 360,
      "startAngle": 0,
      "endAngle": -360,
      "wrap": true
    },
    "dial": {
      "min": 0,
      "max": 360,
      "startAngle": 0,
      "endAngle": 360,
      "wrap": true
    },
    "cdipx": {
      "min": -127,
