{
  "format": 1,
  "name": "727 EPR",
  "author": "FIPinator 3000",
  "description": "Boeing 727 EPR, all three engines on one dial: needles numbered 1, 2, 3. The look of the sim\u0027s 727 panel. The right knob sets all three EPR bugs together (FSS 727; FIPinator Live).",
  "canvas": {
    "width": 320,
    "height": 240,
    "background": "#3E4246"
  },
  "center": [
    160,
    120
  ],
  "font": "../../../assets/fonts/BarlowCondensed-Medium.ttf",
  "values": {
    "epr1": {
      "sim": "TURB ENG PRESSURE RATIO:1",
      "unit": "ratio",
      "default": 1.6
    },
    "epr2": {
      "sim": "TURB ENG PRESSURE RATIO:2",
      "unit": "ratio",
      "default": 1.66
    },
    "epr3": {
      "sim": "TURB ENG PRESSURE RATIO:3",
      "unit": "ratio",
      "default": 1.73
    },
    "eprbugraw1": {
      "sim": "L:FSS_B727_PCP_EPR_BUG1",
      "unit": "number",
      "default": 0.5
    },
    "eprbug1": {
      "expr": "1 \u002B 2 * eprbugraw1"
    },
    "eprcounter1": {
      "expr": "eprbug1 * 100 \u002B 0.5 - (eprbug1 * 100 \u002B 0.5) % 1"
    },
    "eprdigit1a": {
      "expr": "(eprcounter1 - eprcounter1 % 100) / 100"
    },
    "eprdigit1b": {
      "expr": "(eprcounter1 % 100 - eprcounter1 % 10) / 10"
    },
    "eprdigit1c": {
      "expr": "eprcounter1 % 10"
    },
    "eprbugraw2": {
      "sim": "L:FSS_B727_PCP_EPR_BUG2",
      "unit": "number",
      "default": 0.5
    },
    "eprbug2": {
      "expr": "1 \u002B 2 * eprbugraw2"
    },
    "eprbugraw3": {
      "sim": "L:FSS_B727_PCP_EPR_BUG3",
      "unit": "number",
      "default": 0.5
    },
    "eprbug3": {
      "expr": "1 \u002B 2 * eprbugraw3"
    }
  },
