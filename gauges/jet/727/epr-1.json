{
  "format": 1,
  "name": "727 EPR engine 1",
  "author": "FIPinator 3000",
  "description": "Boeing 727 EPR for engine 1, one big dial, the look of the sim\u0027s 727 panel. The EPR bug and its counter follow the cockpit\u0027s; the right knob sets them like the cockpit\u0027s EPR knob (FSS 727; FIPinator Live).",
  "canvas": {
    "width": 320,
    "height": 240,
    "background": "#3E4246"
  },
  "center": [
    160,
    120
  ],
  "font": "../../../assets/fonts/BarlowCondensed-Medium.ttf",
  "values": {
    "epr1": {
      "sim": "TURB ENG PRESSURE RATIO:1",
      "unit": "ratio",
      "default": 1.6
    },
    "eprbugraw1": {
      "sim": "L:FSS_B727_PCP_EPR_BUG1",
      "unit": "number",
      "default": 0.5
    },
    "eprbug1": {
      "expr": "1 \u002B 2 * eprbugraw1"
    },
    "eprcounter1": {
      "expr": "eprbug1 * 100 \u002B 0.5 - (eprbug1 * 100 \u002B 0.5) % 1"
    },
    "eprdigit1a": {
      "expr": "(eprcounter1 - eprcounter1 % 100) / 100"
    },
    "eprdigit1b": {
      "expr": "(eprcounter1 % 100 - eprcounter1 % 10) / 10"
    },
    "eprdigit1c": {
      "expr": "eprcounter1 % 10"
    }
  },
  "scales": {
    "s": {
      "min": 1,
      "max": 3,
      "startAngle": 125,
      "endAngle": 459
    },
    "sub": {
      "min": 0,
      "max": 10,
      "startAngle": 0,
      "endAngle": 360
    },
    "fixed": {
      "min": 0,
      "max": 360,
      "startAngle": 0,
      "endAngle": 360
    }
  },
