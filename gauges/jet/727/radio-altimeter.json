{
  "format": 1,
  "name": "727 Radio altimeter",
  "author": "FIPinator 3000",
  "description": "Boeing 727 (FSS) radio altimeter in black and white: 0-500 ft round to the bottom, up to 2,500 ft up the left, yellow DH bug, green DH light. The right knob sets the DH (10 ft a click), like the cockpit\u0027s knob (FIPinator Live).",
  "canvas": {
    "width": 320,
    "height": 240,
    "background": "#202224"
  },
  "center": [
    160,
    120
  ],
  "font": "../../../assets/fonts/BarlowCondensed-Medium.ttf",
  "values": {
    "needle": {
      "sim": "L:FSS_B727_CP_RADIO_ALT_NEEDLE",
      "unit": "number",
      "default": 0.12
    },
    "dh": {
      "sim": "L:FSS_B727_CP_RADIO_ALT_DH_MARKER",
      "unit": "number",
      "default": 0.2
    },
    "light": {
      "sim": "L:FSS_B727_CP_RADIO_ALT_WARNING_LIGHT",
      "unit": "number",
      "default": 0
    },
    "flag": {
      "sim": "L:FSS_B727_CP_RADIO_ALT_FLAG_VISIBLE",
      "unit": "number",
      "default": 0
    },
    "light_hide": {
      "expr": "choose(light - 0.5, 0, 400)"
    },
    "flag_hide": {
      "expr": "choose(flag - 0.5, 0, 400)"
    }
  },
  "scales": {
    "ft": {
      "points": [
        [
          0,
          0
        ],
        [
          500,
          180
        ],
        [
          1000,
          228
        ],
        [
          1500,
          275
        ],
        [
          2000,
          299
        ],
        [
          2500,
          324
        ],
        [
          2700,
          360
        ]
      ]
    },
    "turn": {
      "min": 0,
      "max": 1,
      "startAngle": 0,
      "endAngle": 360
    },
    "px": {
      "min": 0,
      "max": 400,
      "startAngle": 0,
      "endAngle": 400
    }
  },
