{
  "format": 1,
  "name": "727 Course / ILS",
  "author": "FIPinator 3000",
  "license": "FREE and open source (AGPL-3.0): free to use, change, share and fork.",
  "description": "Course indicator in DC-6 style for NAV 1: course card turned by the OBS, vertical bar for VOR/localizer deviation (or GPS track deviation when the GPS drives NAV 1, with an amber GPS light), horizontal bar for glideslope, TO/FROM triangles, a digital course readout, and red flags when there\u0027s no localizer or glideslope signal.",
  "canvas": {
    "width": 320,
    "height": 240,
    "background": "#66766C"
  },
  "center": [
    160,
    120
  ],
  "font": "../../../assets/fonts/BarlowCondensed-Medium.ttf",
  "values": {
    "obs": {
      "sim": "NAV OBS:1",
      "unit": "degrees",
      "default": 0
    },
    "cdi": {
      "sim": "HSI CDI NEEDLE",
      "unit": "number",
      "default": 30
    },
    "gsi": {
      "sim": "HSI GSI NEEDLE",
      "unit": "number",
      "default": -20
    },
    "has_nav": {
      "sim": "NAV HAS NAV:1",
      "unit": "bool",
      "default": 1
    },
    "has_gs": {
      "sim": "NAV HAS GLIDE SLOPE:1",
      "unit": "bool",
      "default": 1
    },
    "tofrom": {
      "sim": "NAV TOFROM:1",
      "unit": "number",
      "default": 1
    },
    "gps_drives": {
      "sim": "GPS DRIVES NAV1",
      "unit": "bool",
      "default": 0
    },
    "nav_flag_shift": {
      "expr": "choose(has_nav \u002B gps_drives, 400, 0)"
    },
    "gps_light_shift": {
      "expr": "choose(gps_drives, 0, 400)"
    },
    "gs_flag_shift": {
      "expr": "choose(has_gs, 400, 0)"
    },
    "obs_display": {
      "expr": "wrap360(obs \u002B 0.5 - (obs \u002B 0.5) % 1)"
    },
    "to_shift": {
      "expr": "choose(0.5 - abs(tofrom - 1), 0, 400)"
    },
    "from_shift": {
      "expr": "choose(0.5 - abs(tofrom - 2), 0, 400)"
    }
  },
  "scales": {
    "card": {
      "min": 0,
      "max": 360,
      "startAngle": 0,
      "endAngle": -360
    },
    "dial": {
      "min": 0,
      "max": 360,
      "startAngle": 0,
      "endAngle": 360,
      "wrap": true
    },
    "cdi": {
      "min": -127,
      "max": 127,
      "startAngle": -70,
      "endAngle": 70
    },
    "gsi": {
      "min": -127,
      "max": 127,
      "startAngle": -70,
      "endAngle": 70
    },
    "px": {
      "min": -1000,
      "max": 1000,
      "startAngle": -1000,
      "endAngle": 1000
    }
  },
  "controls": {
    "rightKnobClockwise": {
      "event": "VOR1_OBI_INC"
    },
    "rightKnobAnticlockwise": {
      "event": "VOR1_OBI_DEC"
    },
    "leftKnobClockwise": {
      "event": "VOR1_OBI_INC",
      "repeat": 10
    },
    "leftKnobAnticlockwise": {
      "event": "VOR1_OBI_DEC",
      "repeat": 10
    }
  },
