{
  "format": 1,
  "name": "737-800 Standby altimeter and airspeed",
  "author": "FIPinator 3000",
  "description": "737NG standby altimeter and airspeed: pointer once round per 1,000 ft, counter window, MB and IN HG, and an airspeed strip sliding past a pointer. Knobs set the baro.",
  "canvas": {
    "width": 320,
    "height": 240,
    "background": "#4B4F53"
  },
  "center": [
    160,
    120
  ],
  "font": "../../../assets/fonts/BarlowCondensed-Medium.ttf",
  "values": {
    "alt": {
      "sim": "INDICATED ALTITUDE:2",
      "unit": "feet",
      "default": 3740
    },
    "inhg": {
      "sim": "KOHLSMAN SETTING HG:2",
      "unit": "inHg",
      "default": 29.71
    },
    "hpa": {
      "sim": "KOHLSMAN SETTING MB:2",
      "unit": "millibars",
      "default": 1006
    },
    "ias": {
      "sim": "AIRSPEED INDICATED",
      "unit": "knots",
      "default": 140
    },
    "inhg100": {
      "expr": "inhg * 100"
    },
    "hundreds": {
      "expr": "(alt % 1000 \u002B 1000) % 1000"
    },
    "counter": {
      "expr": "alt - alt % 20"
    },
    "hatch_hide": {
      "expr": "choose(10000 - alt, 0, 400)"
    },
    "ias_c": {
      "expr": "clamp(ias, 30, 400)"
    }
  },
  "scales": {
    "k": {
      "min": 0,
      "max": 1000,
      "startAngle": 0,
      "endAngle": 360,
      "wrap": true
    },
    "ias_px": {
      "min": 30,
      "max": 400,
      "startAngle": 0,
      "endAngle": -481
    },
    "px": {
      "min": 0,
      "max": 400,
      "startAngle": 0,
      "endAngle": 400
    }
  },
