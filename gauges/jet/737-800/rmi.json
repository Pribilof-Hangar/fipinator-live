    },
    {
      "type": "text",
      "text": "ADF \u003C--   ==\u003E ADF",
      "x": 160,
      "y": 226,
      "size": 12,
      "color": "#EDE9DC"
    },
    {
      "type": "circle",
      "center": [
        48,
