{
  "format": 1,
  "name": "Boeing 737 MAX FF (modern)",
  "author": "FIPinator 3000",
  "description": "Boeing 737 MAX FF, glass-cockpit style: a dial per engine with a filled sweep and a digital box. Limits: EASA TCDS E.115 (CFM LEAP-1B).",
  "canvas": {
    "width": 320,
    "height": 240,
    "background": "#000000"
  },
  "center": [
    160,
    120
  ],
  "font": "../../../assets/fonts/BarlowCondensed-Medium.ttf",
  "values": {
    "e1_raw": {
      "sim": "ENG FUEL FLOW PPH:1",
      "unit": "pounds per hour",
      "default": 3000
    },
    "e1": {
      "expr": "e1_raw * 0.001"
    },
    "e2_raw": {
      "sim": "ENG FUEL FLOW PPH:2",
      "unit": "pounds per hour",
      "default": 3120
    },
    "e2": {
      "expr": "e2_raw * 0.001"
    }
  },
  "scales": {
    "s": {
      "min": 0,
      "max": 10,
      "startAngle": -100,
      "endAngle": 110
    },
    "px": {
      "min": 0,
      "max": 400,
      "startAngle": 0,
      "endAngle": 400
    }
  },
  "layers": [
    {
      "type": "arc",
      "scale": "s",
      "from": 0,
      "toValue": "e1",
      "radius": 34,
      "width": 68,
      "color": "#5E5E5E",
      "center": [
        80,
        152
      ]
    },
    {
      "type": "arc",
      "scale": "s",
      "from": 0,
      "to": 10,
      "radius": 68,
      "width": 2.5,
      "color": "#F2F2F2",
      "center": [
        80,
        152
      ]
    },
    {
      "type": "ticks",
      "scale": "s",
      "at": [
        0,
        2,
        4,
        6,
        8,
        10
      ],
      "radius": 68,
      "length": 7,
      "width": 2,
      "color": "#F2F2F2",
      "center": [
        80,
        152
      ]
    },
    {
      "type": "labels",
      "scale": "s",
      "at": [
        0,
        2,
        4,
        6,
        8,
        10
      ],
      "divideBy": 1,
      "radius": 51,
      "size": 14.8,
      "color": "#F2F2F2",
      "center": [
        80,
        152
      ]
    },
    {
      "type": "needle",
      "scale": "s",
      "value": "e1",
      "length": 68,
      "width": 2.6,
      "tail": 0,
      "color": "#F2F2F2",
      "center": [
        80,
        152
      ]
    },
    {
      "type": "rect",
      "x": 82,
      "y": 60.8,
      "width": 64.6,
      "height": 27.2,
      "fill": "#000000",
      "stroke": "#F2F2F2",
      "strokeWidth": 1.5
    },
    {
      "type": "text",
