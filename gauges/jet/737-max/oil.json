{
  "format": 1,
  "name": "Boeing 737 MAX Oil (modern)",
  "author": "FIPinator 3000",
  "description": "Boeing 737 MAX oil pressure (psi) and temperature (\u00B0C) per engine; red below 17.4 psi or above 155 \u00B0C. Limits: EASA TCDS E.115 (CFM LEAP-1B).",
  "canvas": {
    "width": 320,
    "height": 240,
    "background": "#000000"
  },
  "center": [
    160,
    120
  ],
  "font": "../../../assets/fonts/BarlowCondensed-Medium.ttf",
  "values": {
    "press1": {
      "sim": "GENERAL ENG OIL PRESSURE:1",
      "unit": "psi",
      "default": 42
    },
    "press1_ok": {
      "expr": "choose(17.4 - press1, 400, 0)"
    },
    "press1_bad": {
      "expr": "choose(17.4 - press1, 0, 400)"
    },
    "press2": {
      "sim": "GENERAL ENG OIL PRESSURE:2",
      "unit": "psi",
      "default": 42
    },
    "press2_ok": {
      "expr": "choose(17.4 - press2, 400, 0)"
    },
    "press2_bad": {
      "expr": "choose(17.4 - press2, 0, 400)"
    },
    "temp1": {
      "sim": "GENERAL ENG OIL TEMPERATURE:1",
      "unit": "celsius",
      "default": 95
    },
    "temp1_ok": {
      "expr": "choose(temp1 - 155, 400, 0)"
    },
    "temp1_bad": {
      "expr": "choose(temp1 - 155, 0, 400)"
    },
    "temp2": {
      "sim": "GENERAL ENG OIL TEMPERATURE:2",
      "unit": "celsius",
      "default": 95
    },
    "temp2_ok": {
      "expr": "choose(temp2 - 155, 400, 0)"
    },
    "temp2_bad": {
      "expr": "choose(temp2 - 155, 0, 400)"
    }
  },
  "scales": {
    "px": {
      "min": 0,
      "max": 400,
      "startAngle": 0,
      "endAngle": 400
    }
  },
  "layers": [
    {
      "type": "text",
      "text": "OIL PRESS",
      "x": 160,
