{
  "format": 1,
  "name": "Jet Fuel",
  "author": "FIPinator 3000",
  "description": "Jet fuel, glass style: tank 1, centre and tank 2 in pounds with how-full sweeps, and the total.",
  "canvas": {
    "width": 320,
    "height": 240,
    "background": "#000000"
  },
  "center": [
    160,
    120
  ],
  "font": "../../../assets/fonts/BarlowCondensed-Medium.ttf",
  "values": {
    "wpg": {
      "sim": "FUEL WEIGHT PER GALLON",
      "unit": "pounds",
      "default": 6.7
    },
    "l_gal": {
      "sim": "FUEL TANK LEFT MAIN QUANTITY",
      "unit": "gallons",
      "default": 1270
    },
    "l_cap": {
      "sim": "FUEL TANK LEFT MAIN CAPACITY",
      "unit": "gallons",
      "default": 1288
    },
    "l_lb": {
      "expr": "l_gal * wpg"
    },
    "l_full": {
      "expr": "clamp(l_gal / max(l_cap, 1), 0, 1)"
    },
    "r_gal": {
      "sim": "FUEL TANK RIGHT MAIN QUANTITY",
      "unit": "gallons",
      "default": 1265
    },
    "r_cap": {
      "sim": "FUEL TANK RIGHT MAIN CAPACITY",
      "unit": "gallons",
      "default": 1288
    },
    "r_lb": {
      "expr": "r_gal * wpg"
    },
    "r_full": {
      "expr": "clamp(r_gal / max(r_cap, 1), 0, 1)"
    },
    "c_gal": {
      "sim": "FUEL TANK CENTER QUANTITY",
      "unit": "gallons",
      "default": 800
    },
    "c_cap": {
      "sim": "FUEL TANK CENTER CAPACITY",
      "unit": "gallons",
      "default": 4290
    },
    "c_lb": {
      "expr": "c_gal * wpg"
    },
    "c_full": {
      "expr": "clamp(c_gal / max(c_cap, 1), 0, 1)"
    },
    "total": {
      "expr": "(l_gal \u002B c_gal \u002B r_gal) * wpg"
    }
  },
  "scales": {
    "f": {
      "min": 0,
      "max": 1,
      "startAngle": -135,
      "endAngle": 135
    }
  },
  "layers": [
    {
