{
  "format": 1,
  "name": "Jet horizon (compact)",
  "author": "FIPinator 3000",
  "description": "Compact jet horizon (laid out like the small display in the middle of a 737 MAX panel): attitude with magenta flight director bars, speed and altitude tapes with readouts, baro in hPa, heading strip.",
  "canvas": {
    "width": 320,
    "height": 240,
    "background": "#000000"
  },
  "center": [
    160,
    112
  ],
  "font": "../../../assets/fonts/BarlowCondensed-Medium.ttf",
  "values": {
    "pitch": {
      "sim": "ATTITUDE INDICATOR PITCH DEGREES",
      "unit": "degrees",
      "default": -4
    },
    "bank": {
      "sim": "ATTITUDE INDICATOR BANK DEGREES",
      "unit": "degrees",
      "default": 10
    },
    "ias": {
      "sim": "AIRSPEED INDICATED",
      "unit": "knots",
      "default": 152
    },
    "alt": {
      "sim": "INDICATED ALTITUDE",
      "unit": "feet",
      "default": 2340
    },
    "hpa": {
      "sim": "KOHLSMAN SETTING MB:1",
      "unit": "millibars",
      "default": 1013
    },
    "hdg": {
      "sim": "PLANE HEADING DEGREES MAGNETIC",
      "unit": "degrees",
      "default": 292
    },
    "fdp": {
      "sim": "AUTOPILOT FLIGHT DIRECTOR PITCH",
      "unit": "degrees",
      "default": -7
    },
    "fdb": {
      "sim": "AUTOPILOT FLIGHT DIRECTOR BANK",
      "unit": "degrees",
      "default": 4
    },
    "fdon": {
      "sim": "AUTOPILOT FLIGHT DIRECTOR ACTIVE",
      "unit": "bool",
      "default": 1
    },
    "fd_y": {
      "expr": "clamp(-(fdp - pitch) * 4, -70, 70)"
    },
    "fd_x": {
      "expr": "clamp((fdb - bank) * 1.5, -70, 70)"
    },
    "fd_hide": {
      "expr": "choose(fdon, 0, 400)"
    },
    "spd_base": {
      "expr": "max(ias, 0) - max(ias, 0) % 20"
    },
    "spd_roll": {
      "expr": "max(ias, 0) % 20"
    },
    "alt_base": {
      "expr": "alt - alt % 100"
    },
    "alt_roll": {
      "expr": "alt % 100"
    },
    "spd_base_0": {
      "expr": "spd_base \u002B -60"
    },
    "spd_base_0_hide": {
      "expr": "choose(spd_base_0 \u002B 1, 0, 400)"
    },
    "spd_base_1": {
      "expr": "spd_base \u002B -40"
    },
    "spd_base_1_hide": {
      "expr": "choose(spd_base_1 \u002B 1, 0, 400)"
    },
    "spd_base_2": {
      "expr": "spd_base \u002B -20"
    },
    "spd_base_2_hide": {
      "expr": "choose(spd_base_2 \u002B 1, 0, 400)"
    },
    "spd_base_3": {
      "expr": "spd_base \u002B 0"
    },
    "spd_base_3_hide": {
      "expr": "choose(spd_base_3 \u002B 1, 0, 400)"
    },
    "spd_base_4": {
      "expr": "spd_base \u002B 20"
    },
    "spd_base_4_hide": {
      "expr": "choose(spd_base_4 \u002B 1, 0, 400)"
    },
    "spd_base_5": {
      "expr": "spd_base \u002B 40"
    },
    "spd_base_5_hide": {
      "expr": "choose(spd_base_5 \u002B 1, 0, 400)"
    },
    "spd_base_6": {
      "expr": "spd_base \u002B 60"
    },
    "spd_base_6_hide": {
      "expr": "choose(spd_base_6 \u002B 1, 0, 400)"
    },
    "alt_base_0": {
      "expr": "alt_base \u002B -300"
    },
    "alt_base_1": {
      "expr": "alt_base \u002B -200"
    },
    "alt_base_2": {
      "expr": "alt_base \u002B -100"
    },
    "alt_base_3": {
      "expr": "alt_base \u002B 0"
    },
    "alt_base_4": {
      "expr": "alt_base \u002B 100"
    },
    "alt_base_5": {
      "expr": "alt_base \u002B 200"
    },
    "alt_base_6": {
      "expr": "alt_base \u002B 300"
    }
  },
  "scales": {
    "bank": {
      "min": -180,
      "max": 180,
      "startAngle": -180,
      "endAngle": 180
    },
    "pitch": {
      "min": -90,
      "max": 90,
      "startAngle": 360,
      "endAngle": -360
    },
    "dial": {
      "min": 0,
      "max": 360,
