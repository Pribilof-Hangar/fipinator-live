{
  "format": 1,
  "name": "Jet Attitude (glass)",
  "author": "FIPinator 3000",
  "description": "Electronic attitude display (EADI style): flat sky and ground, pitch ladder every 2.5 degrees (to 20), bank scale 10/20/30/45/60, radio altitude below 2,500 ft, decision height, slip indicator.",
  "canvas": {
    "width": 320,
    "height": 240,
    "background": "#151515"
  },
  "center": [
    160,
    120
  ],
  "font": "../../../assets/fonts/BarlowCondensed-Medium.ttf",
  "values": {
    "pitch": {
      "sim": "ATTITUDE INDICATOR PITCH DEGREES",
      "unit": "degrees",
      "default": -5
    },
    "bank": {
      "sim": "ATTITUDE INDICATOR BANK DEGREES",
      "unit": "degrees",
      "default": 12
    },
    "ra": {
      "sim": "RADIO HEIGHT",
      "unit": "feet",
      "default": 850
    },
    "dh": {
      "sim": "DECISION HEIGHT",
      "unit": "feet",
      "default": 200
    },
    "ball": {
      "sim": "TURN COORDINATOR BALL",
      "unit": "position",
      "default": 0
    },
    "ra_hide": {
      "expr": "choose(2500 - ra, 0, 400)"
    }
  },
  "scales": {
    "bank": {
      "min": -180,
      "max": 180,
      "startAngle": -180,
      "endAngle": 180
    },
    "pitch": {
      "min": -90,
      "max": 90,
      "startAngle": 360,
      "endAngle": -360
    },
    "dial": {
      "min": 0,
      "max": 360,
      "startAngle": 0,
      "endAngle": 360,
      "wrap": true
    },
    "px": {
      "min": 0,
      "max": 400,
      "startAngle": 0,
      "endAngle": 400
    },
    "ball": {
      "min": -127,
      "max": 127,
      "startAngle": -20,
      "endAngle": 20
    }
  },
