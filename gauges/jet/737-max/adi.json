{
  "format": 1,
  "name": "Jet ADI (airliner)",
  "author": "FIPinator 3000",
  "description": "Airliner ADI, 737-200 style: attitude ball, flight-director crossbars, glideslope pointer, localizer rising runway (rises below 200 ft radio altitude).",
  "canvas": {
    "width": 320,
    "height": 240,
    "background": "#1A1B1D"
  },
  "center": [
    160,
    120
  ],
  "font": "../../../assets/fonts/BarlowCondensed-Medium.ttf",
  "values": {
    "pitch": {
      "sim": "ATTITUDE INDICATOR PITCH DEGREES",
      "unit": "degrees",
      "default": -3
    },
    "bank": {
      "sim": "ATTITUDE INDICATOR BANK DEGREES",
      "unit": "degrees",
      "default": 8
    },
    "fdp": {
      "sim": "AUTOPILOT FLIGHT DIRECTOR PITCH",
      "unit": "degrees",
      "default": -5
    },
    "fdb": {
      "sim": "AUTOPILOT FLIGHT DIRECTOR BANK",
      "unit": "degrees",
      "default": 4
    },
    "fdon": {
      "sim": "AUTOPILOT FLIGHT DIRECTOR ACTIVE",
      "unit": "bool",
      "default": 1
    },
    "gsi": {
      "sim": "NAV GSI:1",
      "unit": "number",
      "default": 30
    },
    "cdi": {
      "sim": "NAV CDI:1",
      "unit": "number",
      "default": -25
    },
    "hasgs": {
      "sim": "NAV HAS GLIDE SLOPE:1",
      "unit": "bool",
      "default": 1
    },
    "hasloc": {
      "sim": "NAV HAS LOCALIZER:1",
      "unit": "bool",
      "default": 1
    },
    "ra": {
      "sim": "RADIO HEIGHT",
      "unit": "feet",
      "default": 900
    },
    "fd_y": {
      "expr": "clamp(-(fdp - pitch) * 3, -40, 40)"
    },
    "fd_x": {
      "expr": "clamp((fdb - bank) * 1.5, -40, 40)"
    },
    "fd_hide": {
      "expr": "choose(fdon, 0, 400)"
    },
    "gs_y": {
      "expr": "clamp(gsi / 127 * 34, -38, 38)"
    },
    "gs_hide": {
      "expr": "choose(hasgs, 0, 400)"
    },
    "loc_x": {
      "expr": "clamp(cdi / 127 * 40, -46, 46)"
    },
    "rise": {
      "expr": "-clamp((200 - ra) / 200, 0, 1) * 30"
    },
    "loc_hide": {
      "expr": "choose(hasloc, 0, 400)"
    }
  },
  "scales": {
    "bank": {
      "min": -180,
      "max": 180,
      "startAngle": -180,
      "endAngle": 180
    },
    "pitch": {
      "min": -90,
      "max": 90,
      "startAngle": 270,
      "endAngle": -270
    },
    "dial": {
      "min": 0,
      "max": 360,
      "startAngle": 0,
      "endAngle": 360,
      "wrap": true
    },
    "px": {
      "min": -400,
      "max": 400,
      "startAngle": -400,
      "endAngle": 400
    }
  },
