{
  "format": 1,
  "name": "Autobrake (Boeing style)",
  "author": "FIPinator 3000",
  "description": "Boeing-style (737) autobrake selector (RTO, OFF, 1, 2, 3, MAX from AUTO BRAKE SWITCH CB 0-5; to check per plane). Knobs turn the selector.",
  "canvas": {
    "width": 320,
    "height": 240,
    "background": "#0B0C0E"
  },
  "center": [
    160,
    120
  ],
  "font": "../../../assets/fonts/BarlowCondensed-Medium.ttf",
  "values": {
    "ab": {
      "sim": "AUTO BRAKE SWITCH CB",
      "unit": "number",
      "default": 3
    },
    "ab_0_hide": {
      "expr": "choose(choose(abs(ab - 0) - 0.5, 0, 1) - 0.5, 0, 400)"
    },
    "ab_1_hide": {
      "expr": "choose(choose(abs(ab - 1) - 0.5, 0, 1) - 0.5, 0, 400)"
    },
    "ab_2_hide": {
      "expr": "choose(choose(abs(ab - 2) - 0.5, 0, 1) - 0.5, 0, 400)"
    },
    "ab_3_hide": {
      "expr": "choose(choose(abs(ab - 3) - 0.5, 0, 1) - 0.5, 0, 400)"
    },
    "ab_4_hide": {
      "expr": "choose(choose(abs(ab - 4) - 0.5, 0, 1) - 0.5, 0, 400)"
    },
    "ab_5_hide": {
      "expr": "choose(choose(abs(ab - 5) - 0.5, 0, 1) - 0.5, 0, 400)"
    }
  },
  "scales": {
    "px": {
      "min": -400,
      "max": 400,
      "startAngle": -400,
      "endAngle": 400
    }
  },
  "layers": [
    {
      "type": "rect",
      "x": 0,
      "y": 0,
      "width": 320,
      "height": 240,
      "fill": "#0B0C0E"
