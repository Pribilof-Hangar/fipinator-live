        {
          "type": "rect",
          "x": 152,
          "y": 110,
          "width": 162,
          "height": 92,
          "radius": 4,
          "stroke": "#7FD6F0",
          "strokeWidth": 2.5
        }
      ]
    },
    {
      "type": "text",
