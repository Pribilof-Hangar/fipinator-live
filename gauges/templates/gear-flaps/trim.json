{
  "format": 1,
  "name": "Trim",
  "author": "FIPinator 3000",
  "description": "Elevator, rudder and aileron trim. S1-S3 pick which trim the knobs set (right knob fine, left knob faster).",
  "canvas": {
    "width": 320,
    "height": 240,
    "background": "#0B0C0E"
  },
  "center": [
    160,
    120
  ],
  "font": "../../../assets/fonts/BarlowCondensed-Medium.ttf",
  "values": {
    "elev": {
      "sim": "ELEVATOR TRIM PCT",
      "unit": "percent over 100",
      "default": 0.15
    },
    "rud": {
      "sim": "RUDDER TRIM PCT",
      "unit": "percent over 100",
      "default": -0.1
    },
    "ail": {
      "sim": "AILERON TRIM PCT",
      "unit": "percent over 100",
      "default": 0.05
    },
    "elev_y": {
      "expr": "clamp(-elev, -1, 1) * 80"
    },
    "rud_x": {
      "expr": "clamp(rud, -1, 1) * 60"
    },
    "ail_x": {
      "expr": "clamp(ail, -1, 1) * 60"
    },
    "knobMode": {
      "default": 1
    },
    "sel1_4_hide": {
      "expr": "choose(choose(abs(knobMode - 1) - 0.5, 0, 1) - 0.5, 0, 400)"
    },
    "sel2_11_hide": {
      "expr": "choose(choose(abs(knobMode - 2) - 0.5, 0, 1) - 0.5, 0, 400)"
    },
    "sel3_18_hide": {
      "expr": "choose(choose(abs(knobMode - 3) - 0.5, 0, 1) - 0.5, 0, 400)"
    }
  },
  "scales": {
    "px": {
      "min": -400,
      "max": 400,
      "startAngle": -400,
      "endAngle": 400
    },
    "ptr": {
      "min": 0,
      "max": 360,
      "startAngle": 0,
      "endAngle": 360,
      "wrap": true
    }
  },
  "layers": [
    {
      "type": "rect",
      "x": 0,
      "y": 0,
      "width": 320,
      "height": 240,
      "fill": "#0B0C0E"
    },
    {
      "type": "text",
      "text": "ELEV",
      "x": 4,
      "y": 25,
      "size": 12,
      "color": "#7FD6F0",
      "align": "left"
    },
    {
      "type": "text",
      "text": "RUDDER",
      "x": 4,
      "y": 65,
      "size": 12,
      "color": "#7FD6F0",
      "align": "left"
    },
    {
      "type": "text",
      "text": "AILERON",
      "x": 4,
      "y": 105,
      "size": 12,
      "color": "#7FD6F0",
      "align": "left"
    },
    {
      "type": "group",
      "moveX": {
        "value": "sel1_4_hide",
        "scale": "px"
      },
      "layers": [
        {
          "type": "rect",
          "x": 50,
          "y": 8,
          "width": 92,
          "height": 224,
          "radius": 4,
          "stroke": "#7FD6F0",
          "strokeWidth": 2.5
        }
      ]
    },
    {
      "type": "text",
      "text": "ELEVATOR",
      "x": 96,
      "y": 26,
      "size": 13,
      "color": "#9AA0A6",
      "align": "center"
    },
    {
      "type": "rect",
      "x": 92,
      "y": 40,
      "width": 8,
      "height": 164,
      "radius": 3,
      "fill": "#17191C",
      "stroke": "#33373C",
      "strokeWidth": 1.2
    },
    {
      "type": "rect",
      "x": 80,
      "y": 121,
      "width": 32,
      "height": 2,
      "radius": 3,
      "fill": "#9AA0A6"
    },
    {
      "type": "text",
      "text": "UP",
