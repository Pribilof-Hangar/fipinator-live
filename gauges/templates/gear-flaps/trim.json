        "scale": "px"
      },
      "layers": [
        {
          "type": "ticks",
          "scale": "ptr",
          "at": [
            180
          ],
          "radius": 22,
          "length": -14,
          "width": 14,
          "color": "#F5A623",
          "shape": "triangle",
          "center": [
            233,
            130
          ]
        }
      ]
    }
  ],
  "modes": [
    {
      "name": "ELEV",
      "button": "button1",
      "controls": {
        "rightKnobClockwise": {
          "event": "ELEV_TRIM_UP"
        },
        "rightKnobAnticlockwise": {
          "event": "ELEV_TRIM_DN"
        },
        "leftKnobClockwise": {
          "event": "ELEV_TRIM_UP",
          "repeat": 10
        },
        "leftKnobAnticlockwise": {
          "event": "ELEV_TRIM_DN",
          "repeat": 10
        }
      }
    },
    {
      "name": "RUDDER",
      "button": "button2",
      "controls": {
        "rightKnobClockwise": {
          "event": "RUDDER_TRIM_RIGHT"
        },
        "rightKnobAnticlockwise": {
          "event": "RUDDER_TRIM_LEFT"
        },
        "leftKnobClockwise": {
          "event": "RUDDER_TRIM_RIGHT",
          "repeat": 10
        },
        "leftKnobAnticlockwise": {
          "event": "RUDDER_TRIM_LEFT",
          "repeat": 10
        }
      }
    },
    {
      "name": "AILERON",
      "button": "button3",
      "controls": {
        "rightKnobClockwise": {
          "event": "AILERON_TRIM_RIGHT"
        },
        "rightKnobAnticlockwise": {
          "event": "AILERON_TRIM_LEFT"
        },
        "leftKnobClockwise": {
          "event": "AILERON_TRIM_RIGHT",
          "repeat": 10
        },
        "leftKnobAnticlockwise": {
          "event": "AILERON_TRIM_LEFT",
          "repeat": 10
        }
      }
    }
  ],
