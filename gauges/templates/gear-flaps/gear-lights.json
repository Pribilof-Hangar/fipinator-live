{
  "format": 1,
  "name": "Landing gear",
  "author": "FIPinator 3000",
  "description": "Gear lights per leg (green DOWN, red IN TRANSIT, dark UP) and the gear handle. S1 moves the gear (GEAR_TOGGLE).",
  "canvas": {
    "width": 320,
    "height": 240,
    "background": "#0B0C0E"
  },
  "center": [
    160,
    120
  ],
  "font": "../../../assets/fonts/BarlowCondensed-Medium.ttf",
  "values": {
    "nose": {
      "sim": "GEAR CENTER POSITION",
      "unit": "percent over 100",
      "default": 1
    },
    "nose_down": {
      "expr": "choose(nose - 0.99, 1, 0)"
    },
    "nose_moving": {
      "expr": "choose(nose - 0.01, choose(0.99 - nose, 1, 0), 0)"
    },
    "nose_down_lamp4_hide": {
      "expr": "choose(nose_down - 0.5, 0, 400)"
    },
    "nose_moving_lamp5_hide": {
      "expr": "choose(nose_moving - 0.5, 0, 400)"
    },
    "nose_up_shown_hide": {
      "expr": "choose(choose(nose - 0.01, 0, 1) - 0.5, 0, 400)"
    },
    "left": {
      "sim": "GEAR LEFT POSITION",
      "unit": "percent over 100",
      "default": 0.5
    },
    "left_down": {
      "expr": "choose(left - 0.99, 1, 0)"
    },
    "left_moving": {
      "expr": "choose(left - 0.01, choose(0.99 - left, 1, 0), 0)"
    },
    "left_down_lamp9_hide": {
      "expr": "choose(left_down - 0.5, 0, 400)"
    },
    "left_moving_lamp10_hide": {
      "expr": "choose(left_moving - 0.5, 0, 400)"
    },
    "left_up_shown_hide": {
      "expr": "choose(choose(left - 0.01, 0, 1) - 0.5, 0, 400)"
    },
    "right": {
      "sim": "GEAR RIGHT POSITION",
      "unit": "percent over 100",
      "default": 1
    },
    "right_down": {
      "expr": "choose(right - 0.99, 1, 0)"
    },
    "right_moving": {
      "expr": "choose(right - 0.01, choose(0.99 - right, 1, 0), 0)"
    },
    "right_down_lamp14_hide": {
      "expr": "choose(right_down - 0.5, 0, 400)"
    },
    "right_moving_lamp15_hide": {
      "expr": "choose(right_moving - 0.5, 0, 400)"
    },
    "right_up_shown_hide": {
      "expr": "choose(choose(right - 0.01, 0, 1) - 0.5, 0, 400)"
    },
    "handle": {
      "sim": "GEAR HANDLE POSITION",
      "unit": "percent over 100",
      "default": 1
    },
    "handle_dn_hide": {
      "expr": "choose(choose(handle - 0.5, 1, 0) - 0.5, 0, 400)"
    },
    "handle_up_hide": {
      "expr": "choose(choose(handle - 0.5, 0, 1) - 0.5, 0, 400)"
    }
  },
  "scales": {
    "px": {
      "min": -400,
      "max": 400,
      "startAngle": -400,
      "endAngle": 400
    }
  },
  "layers": [
