    "n11": {
      "sim": "TURB ENG N1:1",
      "unit": "percent",
      "default": 85
    },
    "n11_ok": {
      "expr": "choose(n11 - 101, 400, 0)"
    },
    "n11_hot": {
      "expr": "choose(n11 - 101, 0, 400)"
    },
    "egt1": {
      "sim": "ENG EXHAUST GAS TEMPERATURE:1",
      "unit": "celsius",
      "default": 650
    },
    "egt1_ok": {
      "expr": "choose(egt1 - 1060, 400, 0)"
    },
    "egt1_hot": {
      "expr": "choose(egt1 - 1060, 0, 400)"
    },
    "n21": {
      "sim": "TURB ENG N2:1",
      "unit": "percent",
      "default": 90
    },
    "ff1_raw": {
      "sim": "ENG FUEL FLOW PPH:1",
      "unit": "pounds per hour",
      "default": 3000
    },
    "ff1": {
      "expr": "ff1_raw * 0.45359237"
    },
    "n21_ok": {
      "expr": "choose(n21 - 116.5, 400, 0)"
    },
    "n21_hot": {
      "expr": "choose(n21 - 116.5, 0, 400)"
    },
