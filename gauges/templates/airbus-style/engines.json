{
  "format": 1,
  "name": "Engines (Airbus style)",
  "author": "FIPinator 3000",
  "description": "Airbus A320neo: N1 and EGT dials and N2 and fuel flow numbers for every engine on one screen, Airbus ECAM style, fuel flow in kg/h. Limits: EASA TCDS E.110 (CFM LEAP-1A).",
  "canvas": {
    "width": 320,
    "height": 240,
    "background": "#0A0D12"
  },
  "center": [
    160,
    120
  ],
  "font": "../../../assets/fonts/BarlowCondensed-Medium.ttf",
