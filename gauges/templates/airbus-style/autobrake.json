{
  "format": 1,
  "name": "Autobrake (Airbus style)",
  "author": "FIPinator 3000",
  "description": "Airbus-style autobrake: LO, MED, MAX on S1-S3 (SET_AUTOBRAKE_CONTROL 1, 2, 3; to check per plane), the chosen one lit.",
  "canvas": {
    "width": 320,
    "height": 240,
    "background": "#16191D"
  },
  "center": [
    160,
    120
  ],
  "font": "../../../assets/fonts/BarlowCondensed-Medium.ttf",
  "values": {
    "ab": {
      "sim": "AUTO BRAKE SWITCH CB",
      "unit": "number",
      "default": 2
    },
    "on1": {
      "expr": "choose(abs(ab - 1) - 0.5, 0, 1)"
    },
    "on1_lamp5_hide": {
      "expr": "choose(on1 - 0.5, 0, 400)"
    },
    "on2": {
      "expr": "choose(abs(ab - 2) - 0.5, 0, 1)"
    },
    "on2_lamp9_hide": {
      "expr": "choose(on2 - 0.5, 0, 400)"
    },
    "on3": {
      "expr": "choose(abs(ab - 3) - 0.5, 0, 1)"
    },
    "on3_lamp13_hide": {
      "expr": "choose(on3 - 0.5, 0, 400)"
    }
  },
  "scales": {
    "px": {
      "min": -400,
      "max": 400,
      "startAngle": -400,
      "endAngle": 400
    }
  },
  "layers": [
    {
      "type": "rect",
      "x": 0,
      "y": 0,
      "width": 320,
      "height": 240,
      "fill": "#16191D"
    },
