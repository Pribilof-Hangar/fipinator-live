{
  "format": 1,
  "name": "Landing gear (Airbus style)",
  "author": "FIPinator 3000",
  "description": "Airbus ECAM-style gear: a triangle per leg (green down, red moving, dark up) and the lever position. S1 moves the gear.",
  "canvas": {
    "width": 320,
    "height": 240,
    "background": "#0A0D12"
  },
  "center": [
    160,
    120
  ],
  "font": "../../../assets/fonts/BarlowCondensed-Medium.ttf",
  "values": {
    "nose": {
      "sim": "GEAR CENTER POSITION",
      "unit": "percent over 100",
      "default": 1
    },
    "nose_down": {
      "expr": "choose(nose - 0.99, 1, 0)"
    },
    "nose_moving": {
      "expr": "choose(nose - 0.01, choose(0.99 - nose, 1, 0), 0)"
    },
    "nose_g_hide": {
      "expr": "choose(nose_down - 0.5, 0, 400)"
    },
    "nose_r_hide": {
      "expr": "choose(nose_moving - 0.5, 0, 400)"
    },
    "left": {
      "sim": "GEAR LEFT POSITION",
      "unit": "percent over 100",
      "default": 1
    },
    "left_down": {
      "expr": "choose(left - 0.99, 1, 0)"
    },
    "left_moving": {
      "expr": "choose(left - 0.01, choose(0.99 - left, 1, 0), 0)"
    },
    "left_g_hide": {
      "expr": "choose(left_down - 0.5, 0, 400)"
    },
    "left_r_hide": {
      "expr": "choose(left_moving - 0.5, 0, 400)"
    },
    "right": {
      "sim": "GEAR RIGHT POSITION",
      "unit": "percent over 100",
      "default": 0.5
    },
    "right_down": {
      "expr": "choose(right - 0.99, 1, 0)"
    },
    "right_moving": {
      "expr": "choose(right - 0.01, choose(0.99 - right, 1, 0), 0)"
    },
    "right_g_hide": {
      "expr": "choose(right_down - 0.5, 0, 400)"
    },
    "right_r_hide": {
      "expr": "choose(right_moving - 0.5, 0, 400)"
    },
    "lever": {
      "sim": "GEAR HANDLE POSITION",
      "unit": "percent over 100",
      "default": 1
    },
    "lever_dn_hide": {
      "expr": "choose(choose(lever - 0.5, 1, 0) - 0.5, 0, 400)"
    },
    "lever_up_hide": {
      "expr": "choose(choose(lever - 0.5, 0, 1) - 0.5, 0, 400)"
    }
  },
  "scales": {
    "px": {
      "min": -400,
      "max": 400,
      "startAngle": -400,
      "endAngle": 400
    },
    "tri": {
      "min": 0,
      "max": 360,
      "startAngle": 0,
      "endAngle": 360,
      "wrap": true
    }
  },
  "layers": [
    {
      "type": "rect",
      "x": 0,
      "y": 0,
      "width": 320,
      "height": 240,
      "fill": "#0A0D12"
    },
