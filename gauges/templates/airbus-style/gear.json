      "x": 175,
      "y": 28,
      "size": 15,
      "color": "#EDEDED",
      "align": "center"
    },
    {
      "type": "ticks",
      "scale": "tri",
      "at": [
        180
      ],
      "radius": 16,
      "length": -30,
      "width": 40,
      "color": "#1E242B",
