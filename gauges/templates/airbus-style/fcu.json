{
  "format": 1,
  "name": "FCU (Airbus style)",
  "author": "FIPinator 3000",
  "description": "Airbus FCU-style autopilot display: speed, heading, altitude and vertical speed in orange digits. S1-S4 pick which one the knobs set (left knob faster); S6 AP1 on/off with its light.",
  "canvas": {
    "width": 320,
    "height": 240,
    "background": "#16191D"
  },
  "center": [
    160,
    120
  ],
  "font": "../../../assets/fonts/BarlowCondensed-Medium.ttf",
  "values": {
    "spd": {
      "sim": "AUTOPILOT AIRSPEED HOLD VAR",
      "unit": "knots",
      "default": 250
    },
    "hdg": {
      "sim": "AUTOPILOT HEADING LOCK DIR",
      "unit": "degrees",
      "default": 270
    },
    "alt": {
      "sim": "AUTOPILOT ALTITUDE LOCK VAR",
      "unit": "feet",
      "default": 12000
    },
    "vs": {
      "sim": "AUTOPILOT VERTICAL HOLD VAR",
      "unit": "feet per minute",
      "default": -800
    },
    "ap": {
      "sim": "AUTOPILOT MASTER",
      "unit": "bool",
      "default": 1
    },
    "knobMode": {
      "default": 1
    },
    "sel1_8_hide": {
      "expr": "choose(choose(abs(knobMode - 1) - 0.5, 0, 1) - 0.5, 0, 400)"
    },
    "sel2_11_hide": {
      "expr": "choose(choose(abs(knobMode - 2) - 0.5, 0, 1) - 0.5, 0, 400)"
    },
    "sel3_14_hide": {
      "expr": "choose(choose(abs(knobMode - 3) - 0.5, 0, 1) - 0.5, 0, 400)"
    },
    "sel4_17_hide": {
      "expr": "choose(choose(abs(knobMode - 4) - 0.5, 0, 1) - 0.5, 0, 400)"
    },
    "ap_lamp21_hide": {
      "expr": "choose(ap - 0.5, 0, 400)"
    }
  },
  "scales": {
    "px": {
      "min": -400,
      "max": 400,
      "startAngle": -400,
      "endAngle": 400
    }
  },
  "layers": [
    {
      "type": "rect",
      "x": 0,
      "y": 0,
      "width": 320,
      "height": 240,
      "fill": "#16191D"
    },
    {
      "type": "text",
      "text": "SPD",
      "x": 4,
      "y": 25,
      "size": 12,
      "color": "#7FD6F0",
      "align": "left"
    },
    {
      "type": "text",
      "text": "HDG",
      "x": 4,
      "y": 65,
      "size": 12,
      "color": "#7FD6F0",
      "align": "left"
    },
    {
      "type": "text",
      "text": "ALT",
      "x": 4,
      "y": 105,
      "size": 12,
      "color": "#7FD6F0",
      "align": "left"
    },
    {
      "type": "text",
      "text": "V/S",
      "x": 4,
      "y": 145,
      "size": 12,
      "color": "#7FD6F0",
      "align": "left"
    },
    {
      "type": "rect",
      "x": 50,
      "y": 34,
      "width": 266,
      "height": 92,
      "radius": 3,
      "fill": "#050505",
      "stroke": "#2B2F34",
      "strokeWidth": 1.2
    },
    {
      "type": "text",
      "text": "SPD",
