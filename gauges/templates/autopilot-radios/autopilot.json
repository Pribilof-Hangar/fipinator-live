{
  "format": 1,
  "name": "Autopilot settings",
  "author": "FIPinator 3000",
  "description": "Autopilot speed, heading, altitude and vertical speed. S1-S4 pick which one the knobs set (left knob faster); S6 turns the autopilot on or off.",
  "canvas": {
    "width": 320,
    "height": 240,
    "background": "#0B0C0E"
  },
  "center": [
    160,
    120
  ],
  "font": "../../../assets/fonts/BarlowCondensed-Medium.ttf",
  "values": {
    "spd": {
      "sim": "AUTOPILOT AIRSPEED HOLD VAR",
      "unit": "knots",
      "default": 250
    },
    "hdg": {
      "sim": "AUTOPILOT HEADING LOCK DIR",
      "unit": "degrees",
      "default": 270
    },
    "alt": {
      "sim": "AUTOPILOT ALTITUDE LOCK VAR",
      "unit": "feet",
      "default": 12000
    },
    "vs": {
      "sim": "AUTOPILOT VERTICAL HOLD VAR",
      "unit": "feet per minute",
      "default": -800
    },
    "ap": {
      "sim": "AUTOPILOT MASTER",
      "unit": "bool",
      "default": 1
    },
    "knobMode": {
      "default": 1
    },
    "sel1_5_hide": {
      "expr": "choose(choose(abs(knobMode - 1) - 0.5, 0, 1) - 0.5, 0, 400)"
    },
    "sel2_10_hide": {
      "expr": "choose(choose(abs(knobMode - 2) - 0.5, 0, 1) - 0.5, 0, 400)"
    },
    "sel3_15_hide": {
      "expr": "choose(choose(abs(knobMode - 3) - 0.5, 0, 1) - 0.5, 0, 400)"
    },
    "sel4_20_hide": {
      "expr": "choose(choose(abs(knobMode - 4) - 0.5, 0, 1) - 0.5, 0, 400)"
    },
    "ap_lamp27_hide": {
      "expr": "choose(ap - 0.5, 0, 400)"
    },
    "ap_off_hide": {
      "expr": "choose(choose(ap - 0.5, 0, 1) - 0.5, 0, 400)"
    }
  },
  "scales": {
    "px": {
      "min": -400,
      "max": 400,
      "startAngle": -400,
      "endAngle": 400
    }
  },
  "layers": [
