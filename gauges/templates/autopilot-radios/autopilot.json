  "controls": {
    "button6": {
      "event": "AP_MASTER"
    }
  },
  "modes": [
    {
      "name": "SPD",
      "button": "button1",
      "controls": {
        "rightKnobClockwise": {
          "event": "AP_SPD_VAR_INC"
        },
        "rightKnobAnticlockwise": {
          "event": "AP_SPD_VAR_DEC"
        },
        "leftKnobClockwise": {
          "event": "AP_SPD_VAR_INC",
          "repeat": 10
        },
        "leftKnobAnticlockwise": {
          "event": "AP_SPD_VAR_DEC",
          "repeat": 10
        }
      }
    },
    {
      "name": "HDG",
      "button": "button2",
      "controls": {
        "rightKnobClockwise": {
          "event": "HEADING_BUG_INC"
        },
        "rightKnobAnticlockwise": {
          "event": "HEADING_BUG_DEC"
        },
        "leftKnobClockwise": {
          "event": "HEADING_BUG_INC",
          "repeat": 10
        },
        "leftKnobAnticlockwise": {
          "event": "HEADING_BUG_DEC",
          "repeat": 10
        }
      }
    },
    {
      "name": "ALT",
      "button": "button3",
      "controls": {
        "rightKnobClockwise": {
          "event": "AP_ALT_VAR_INC"
        },
        "rightKnobAnticlockwise": {
          "event": "AP_ALT_VAR_DEC"
        },
        "leftKnobClockwise": {
          "event": "AP_ALT_VAR_INC",
          "repeat": 10
        },
        "leftKnobAnticlockwise": {
          "event": "AP_ALT_VAR_DEC",
          "repeat": 10
        }
      }
    },
    {
      "name": "V/S",
      "button": "button4",
      "controls": {
        "rightKnobClockwise": {
          "event": "AP_VS_VAR_INC"
        },
        "rightKnobAnticlockwise": {
          "event": "AP_VS_VAR_DEC"
        },
        "leftKnobClockwise": {
          "event": "AP_VS_VAR_INC",
          "repeat": 5
        },
        "leftKnobAnticlockwise": {
          "event": "AP_VS_VAR_DEC",
          "repeat": 5
        }
      }
    }
  ],
  "buttonLights": {
