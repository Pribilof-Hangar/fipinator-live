  "modes": [
    {
      "name": "first two digits",
      "button": "button1",
      "controls": {
        "rightKnobClockwise": {
          "event": "XPNDR_100_INC"
        },
        "rightKnobAnticlockwise": {
          "event": "XPNDR_100_DEC"
        },
        "leftKnobClockwise": {
          "event": "XPNDR_1000_INC"
        },
        "leftKnobAnticlockwise": {
          "event": "XPNDR_1000_DEC"
        }
      }
    },
    {
      "name": "last two digits",
      "button": "button2",
      "controls": {
        "rightKnobClockwise": {
          "event": "XPNDR_1_INC"
        },
        "rightKnobAnticlockwise": {
          "event": "XPNDR_1_DEC"
        },
        "leftKnobClockwise": {
          "event": "XPNDR_10_INC"
        },
        "leftKnobAnticlockwise": {
          "event": "XPNDR_10_DEC"
        }
      }
    }
  ],
