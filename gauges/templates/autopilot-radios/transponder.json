{
  "format": 1,
  "name": "Transponder",
  "author": "FIPinator 3000",
  "description": "Transponder code and mode. S1 picks the first two digits, S2 the last two: the left knob sets the left digit of the pair, the right knob the right one.",
  "canvas": {
    "width": 320,
    "height": 240,
    "background": "#0B0C0E"
  },
  "center": [
    160,
    120
  ],
  "font": "../../../assets/fonts/BarlowCondensed-Medium.ttf",
  "values": {
    "code": {
      "sim": "TRANSPONDER CODE:1",
      "unit": "Bco16",
      "default": 4608
    },
    "state": {
      "sim": "TRANSPONDER STATE:1",
      "unit": "number",
      "default": 4
    },
    "d1": {
      "expr": "(code - code % 4096) / 4096 % 16"
    },
    "d2": {
      "expr": "(code % 4096 - code % 256) / 256"
    },
    "d3": {
      "expr": "(code % 256 - code % 16) / 16"
    },
    "d4": {
      "expr": "code % 16"
    },
    "knobMode": {
      "default": 1
    },
    "sel1_9_hide": {
      "expr": "choose(choose(abs(knobMode - 1) - 0.5, 0, 1) - 0.5, 0, 400)"
    },
    "sel2_10_hide": {
      "expr": "choose(choose(abs(knobMode - 2) - 0.5, 0, 1) - 0.5, 0, 400)"
    },
    "state_0_hide": {
      "expr": "choose(choose(abs(state - 0) - 0.5, 0, 1) - 0.5, 0, 400)"
    },
    "state_1_hide": {
      "expr": "choose(choose(abs(state - 1) - 0.5, 0, 1) - 0.5, 0, 400)"
    },
    "state_2_hide": {
      "expr": "choose(choose(abs(state - 2) - 0.5, 0, 1) - 0.5, 0, 400)"
    },
    "state_3_hide": {
      "expr": "choose(choose(abs(state - 3) - 0.5, 0, 1) - 0.5, 0, 400)"
    },
    "state_4_hide": {
      "expr": "choose(choose(abs(state - 4) - 0.5, 0, 1) - 0.5, 0, 400)"
    },
    "state_5_hide": {
      "expr": "choose(choose(abs(state - 5) - 0.5, 0, 1) - 0.5, 0, 400)"
    }
  },
  "scales": {
    "px": {
      "min": -400,
      "max": 400,
      "startAngle": -400,
      "endAngle": 400
    }
  },
  "layers": [
    {
      "type": "rect",
      "x": 0,
      "y": 0,
      "width": 320,
      "height": 240,
      "fill": "#0B0C0E"
    },
    {
      "type": "text",
      "text": "12\u00B7\u00B7",
      "x": 4,
      "y": 25,
      "size": 12,
      "color": "#7FD6F0",
      "align": "left"
    },
    {
      "type": "text",
      "text": "\u00B7\u00B734",
