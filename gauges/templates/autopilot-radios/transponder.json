      "x": 182,
      "y": 30,
      "size": 15,
      "color": "#9AA0A6",
      "align": "center"
    },
    {
      "type": "rect",
      "x": 90,
      "y": 52,
      "width": 186,
      "height": 86,
      "radius": 3,
      "fill": "#000000",
      "stroke": "#33373C",
      "strokeWidth": 1.2
    },
    {
      "type": "text",
