    "egt2_f": {
      "sim": "ENG EXHAUST GAS TEMPERATURE:2",
      "unit": "fahrenheit",
      "default": 280
    },
    "egt1": {
      "expr": "clamp(egt1_f / 100, 0, 5)"
    },
    "egt2": {
      "expr": "clamp(egt2_f / 100, 0, 5)"
    }
  },
