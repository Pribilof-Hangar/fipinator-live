{
  "format": 1,
  "name": "Titan Fuel quantity",
  "author": "FIPinator 3000",
  "description": "Cessna 404 Titan fuel quantity: two edgewise scales, 0-12 hundred lb per side (gallons marked in blue), L and R pointers.",
  "canvas": {
    "width": 320,
    "height": 240,
    "background": "#3D4145"
  },
  "center": [
    160,
    120
  ],
  "font": "../../../assets/fonts/BarlowCondensed-Medium.ttf",
  "values": {
    "fuel_lb_gal": {
      "sim": "FUEL WEIGHT PER GALLON",
      "unit": "pounds",
      "default": 6
    },
    "fuel_l_gal": {
      "sim": "FUEL LEFT QUANTITY",
      "unit": "gallons",
      "default": 85
    },
    "fuel_r_gal": {
      "sim": "FUEL RIGHT QUANTITY",
      "unit": "gallons",
      "default": 85
    },
    "fuel_l": {
      "expr": "clamp(fuel_l_gal * fuel_lb_gal / 100, 0, 12)"
    },
    "fuel_r": {
      "expr": "clamp(fuel_r_gal * fuel_lb_gal / 100, 0, 12)"
    }
  },
