{
  "format": 1,
  "name": "Classic RMI VOR",
  "author": "FIPinator 3000",
  "license": "FREE and open source (AGPL-3.0): free to use, change, share and fork.",
  "description": "Radio magnetic indicator in DC-6 style for the VOR receivers: compass card turning with heading, single-line needle for VOR 1 and double-line needle for VOR 2, pointing to the station. Needles rest at 3 o\u0027clock with no VOR signal.",
  "canvas": {
    "width": 320,
    "height": 240,
    "background": "#8D908E"
  },
  "center": [
    160,
    120
  ],
  "font": "../../../assets/fonts/BarlowCondensed-Medium.ttf",
  "values": {
    "heading": {
      "sim": "PLANE HEADING DEGREES MAGNETIC",
      "unit": "degrees",
      "default": 292
    },
    "vor1_radial": {
      "sim": "NAV RADIAL:1",
      "unit": "degrees",
      "default": 160
    },
    "vor1_signal": {
      "sim": "NAV HAS NAV:1",
      "unit": "bool",
      "default": 1
    },
    "vor2_radial": {
      "sim": "NAV RADIAL:2",
      "unit": "degrees",
      "default": 60
    },
    "vor2_signal": {
      "sim": "NAV HAS NAV:2",
      "unit": "bool",
      "default": 1
    },
    "vor1_needle": {
      "expr": "choose(vor1_signal, wrap360(vor1_radial \u002B 180 - heading), 90)"
    },
    "vor2_needle": {
      "expr": "choose(vor2_signal, wrap360(vor2_radial \u002B 180 - heading), 90)"
    }
  },
  "scales": {
    "card": {
      "min": 0,
      "max": 360,
      "startAngle": 0,
      "endAngle": -360
    },
    "dial": {
      "min": 0,
      "max": 360,
      "startAngle": 0,
      "endAngle": 360,
      "wrap": true
    }
  },
  "controls": {
    "rightKnobClockwise": {
      "event": "HEADING_BUG_INC"
    },
    "rightKnobAnticlockwise": {
      "event": "HEADING_BUG_DEC"
    },
    "leftKnobClockwise": {
      "event": "HEADING_BUG_INC",
      "repeat": 10
    },
    "leftKnobAnticlockwise": {
      "event": "HEADING_BUG_DEC",
      "repeat": 10
    }
  },
  "layers": [
    {
      "type": "screw",
      "x": 58,
      "y": 18,
      "kind": "steel"
    },
    {
      "type": "screw",
      "x": 262,
      "y": 18,
      "kind": "steel"
    },
    {
      "type": "screw",
      "x": 58,
      "y": 222,
      "kind": "steel"
    },
    {
      "type": "screw",
      "x": 262,
      "y": 222,
      "kind": "steel"
    },
    {
      "type": "circle",
      "r": 114,
      "fill": "#40000000"
    },
    {
      "type": "circle",
      "r": 112,
      "fillTop": "#3B3C3D",
      "fillBottom": "#050505"
    },
    {
      "type": "circle",
      "r": 101,
      "fillTop": "#1E1E1E",
      "fillBottom": "#060606",
      "stroke": "#000000",
      "strokeWidth": 2
    },
    {
      "type": "circle",
      "r": 103,
      "stroke": "#994A4B4C",
      "strokeWidth": 1
    },
    {
      "type": "group",
      "offset": [
        8.98,
        6.73
      ],
      "zoom": 0.9439,
      "layers": [
        {
          "type": "group",
          "rotate": {
            "value": "heading",
            "scale": "card"
          },
          "layers": [
            {
              "type": "ticks",
              "scale": "dial",
              "every": 5,
              "from": 0,
              "to": 355,
              "radius": 97,
              "length": 6,
              "width": 1.3,
              "color": "#E3DA9E"
            },
            {
              "type": "ticks",
              "scale": "dial",
              "every": 10,
              "from": 0,
              "to": 350,
              "radius": 97,
              "length": 11,
              "width": 2,
              "color": "#E3DA9E"
            },
            {
              "type": "labels",
              "scale": "dial",
              "every": 30,
              "from": 0,
              "to": 330,
              "radius": 72,
              "size": 22,
              "color": "#EFE6CF",
              "orient": "radial",
              "divideBy": 10
            }
          ]
        },
        {
          "type": "ticks",
          "scale": "dial",
          "every": 45,
          "from": 45,
          "to": 315,
          "radius": 106,
          "length": 8,
          "width": 9,
          "color": "#E0D3A8",
          "shape": "triangle"
        },
        {
          "type": "ticks",
          "scale": "dial",
          "at": [
            0
          ],
          "radius": 107,
          "length": 13,
          "width": 14,
          "color": "#E0D3A8",
          "shape": "triangle"
        },
        {
          "type": "needle",
          "scale": "dial",
          "value": "vor2_needle",
          "style": "doubleArrow",
          "length": 88,
          "tail": 76,
          "width": 1.8,
          "color": "#EFE6CF",
          "shadow": true
        },
        {
          "type": "needle",
          "scale": "dial",
          "value": "vor1_needle",
          "style": "arrow",
          "length": 92,
          "tail": 80,
          "width": 2,
          "color": "#EFE6CF",
          "shadow": true
        },
        {
          "type": "hub",
          "r": 7,
          "fill": "#1A1A1A",
          "stroke": "#5A5A5A"
        }
      ]
    },
    {
      "type": "glare",
      "r": 100,
      "opacity": 0.16
    },
    {
      "type": "text",
      "text": "\u003C VOR 1",
      "x": 4,
      "y": 236,
      "size": 10,
      "color": "#EFE6CF",
      "align": "left"
    },
    {
      "type": "text",
      "text": "VOR 2 \u003E\u003E",
      "x": 316,
      "y": 236,
      "size": 10,
      "color": "#EFE6CF",
      "align": "right"
    }
  ]
}
