{
  "format": 1,
  "name": "Classic RMI VOR 1 \u002B VOR 2 \u002B ADF 1 \u002B ADF 2",
  "author": "FIPinator 3000",
  "license": "FREE and open source (AGPL-3.0): free to use, change, share and fork.",
  "description": "Four-needle radio magnetic indicator for panels with fewer FIPs: compass card turning with heading, yellow needles point to the VOR 1 (single line) and VOR 2 (double line) stations, light needles point to the ADF 1 (single line) and ADF 2 (double line) stations. Each needle rests at 3 o\u0027clock with no signal. Orange heading bug on the card shows the autopilot heading; the knobs move it (right 1 degree, left 10 degrees per click); its setting also shows as 3 digits in the upper right.",
  "canvas": {
    "width": 320,
    "height": 240,
    "background": "#8D908E"
  },
  "center": [
    160,
    120
  ],
  "font": "../../../assets/fonts/BarlowCondensed-Medium.ttf",
  "values": {
    "heading": {
      "sim": "PLANE HEADING DEGREES MAGNETIC",
      "unit": "degrees",
      "default": 292
    },
    "vor1_radial": {
      "sim": "NAV RADIAL:1",
      "unit": "degrees",
      "default": 100
    },
    "vor1_signal": {
      "sim": "NAV HAS NAV:1",
      "unit": "bool",
      "default": 1
    },
    "vor2_radial": {
      "sim": "NAV RADIAL:2",
      "unit": "degrees",
      "default": 160
    },
    "vor2_signal": {
      "sim": "NAV HAS NAV:2",
      "unit": "bool",
      "default": 1
    },
    "adf1_bearing": {
      "sim": "ADF RADIAL:1",
      "unit": "degrees",
      "default": 320
    },
    "adf1_signal": {
      "sim": "ADF SIGNAL:1",
      "unit": "number",
      "default": 1
    },
    "adf2_bearing": {
      "sim": "ADF RADIAL:2",
      "unit": "degrees",
      "default": 200
    },
    "adf2_signal": {
      "sim": "ADF SIGNAL:2",
      "unit": "number",
      "default": 1
    },
    "vor1_needle": {
      "expr": "choose(vor1_signal, wrap360(vor1_radial \u002B 180 - heading), 90)"
    },
    "vor2_needle": {
      "expr": "choose(vor2_signal, wrap360(vor2_radial \u002B 180 - heading), 90)"
    },
    "adf1_needle": {
      "expr": "choose(adf1_signal, adf1_bearing, 90)"
    },
    "adf2_needle": {
      "expr": "choose(adf2_signal, adf2_bearing, 90)"
    },
    "hdg_bug": {
      "sim": "AUTOPILOT HEADING LOCK DIR",
      "unit": "degrees",
      "default": 310
    },
    "hdg_display": {
      "expr": "wrap360(hdg_bug \u002B 0.5 - (hdg_bug \u002B 0.5) % 1)"
    }
  },
  "scales": {
    "card": {
      "min": 0,
      "max": 360,
      "startAngle": 0,
      "endAngle": -360
    },
    "dial": {
      "min": 0,
      "max": 360,
      "startAngle": 0,
      "endAngle": 360,
      "wrap": true
    }
  },
  "controls": {
    "rightKnobClockwise": {
      "event": "HEADING_BUG_INC"
    },
    "rightKnobAnticlockwise": {
      "event": "HEADING_BUG_DEC"
    },
    "leftKnobClockwise": {
      "event": "HEADING_BUG_INC",
      "repeat": 10
    },
    "leftKnobAnticlockwise": {
      "event": "HEADING_BUG_DEC",
      "repeat": 10
    }
  },
  "layers": [
    {
      "type": "screw",
      "x": 58,
      "y": 18,
      "kind": "steel"
    },
    {
      "type": "screw",
      "x": 262,
      "y": 18,
      "kind": "steel"
    },
    {
      "type": "screw",
      "x": 58,
      "y": 222,
      "kind": "steel"
    },
    {
      "type": "screw",
      "x": 262,
      "y": 222,
      "kind": "steel"
    },
    {
