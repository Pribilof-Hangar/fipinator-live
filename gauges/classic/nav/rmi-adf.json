{
  "format": 1,
  "name": "Classic RMI ADF",
  "author": "FIPinator 3000",
  "license": "FREE and open source (AGPL-3.0): free to use, change, share and fork.",
  "description": "Radio magnetic indicator in DC-6 style: compass card turning with heading, single-line needle for ADF 1 and double-line needle for ADF 2. Needles rest at 3 o\u0027clock when their ADF has no signal.",
  "canvas": {
    "width": 320,
    "height": 240,
    "background": "#8D908E"
  },
  "center": [
    160,
    120
  ],
  "font": "../../../assets/fonts/BarlowCondensed-Medium.ttf",
  "values": {
    "heading": {
      "sim": "PLANE HEADING DEGREES MAGNETIC",
      "unit": "degrees",
      "default": 292
    },
    "adf1_bearing": {
      "sim": "ADF RADIAL:1",
      "unit": "degrees",
      "default": 40
    },
    "adf1_signal": {
      "sim": "ADF SIGNAL:1",
      "unit": "number",
      "default": 1
    },
    "adf2_bearing": {
      "sim": "ADF RADIAL:2",
      "unit": "degrees",
      "default": 320
    },
    "adf2_signal": {
      "sim": "ADF SIGNAL:2",
      "unit": "number",
      "default": 1
    },
    "adf1_needle": {
      "expr": "choose(adf1_signal, adf1_bearing, 90)"
    },
    "adf2_needle": {
      "expr": "choose(adf2_signal, adf2_bearing, 90)"
    }
  },
  "scales": {
    "card": {
      "min": 0,
      "max": 360,
      "startAngle": 0,
      "endAngle": -360
    },
    "dial": {
      "min": 0,
      "max": 360,
      "startAngle": 0,
      "endAngle": 360,
      "wrap": true
    }
  },
  "layers": [
    {
      "type": "screw",
      "x": 58,
      "y": 18,
      "kind": "steel"
    },
    {
      "type": "screw",
      "x": 262,
      "y": 18,
      "kind": "steel"
    },
    {
      "type": "screw",
      "x": 58,
      "y": 222,
      "kind": "steel"
    },
    {
      "type": "screw",
      "x": 262,
      "y": 222,
      "kind": "steel"
    },
    {
      "type": "circle",
      "r": 114,
      "fill": "#40000000"
    },
    {
      "type": "circle",
      "r": 112,
      "fillTop": "#3B3C3D",
      "fillBottom": "#050505"
    },
    {
      "type": "circle",
      "r": 101,
      "fillTop": "#1E1E1E",
      "fillBottom": "#060606",
      "stroke": "#000000",
      "strokeWidth": 2
    },
    {
      "type": "circle",
      "r": 103,
      "stroke": "#994A4B4C",
      "strokeWidth": 1
    },
    {
      "type": "group",
      "offset": [
        8.98,
        6.73
      ],
      "zoom": 0.9439,
      "layers": [
        {
          "type": "group",
          "rotate": {
            "value": "heading",
            "scale": "card"
          },
          "layers": [
            {
              "type": "ticks",
              "scale": "dial",
              "every": 5,
              "from": 0,
              "to": 355,
              "radius": 97,
              "length": 6,
              "width": 1.3,
              "color": "#EFE6CF"
            },
            {
              "type": "ticks",
              "scale": "dial",
              "every": 10,
              "from": 0,
              "to": 350,
              "radius": 97,
              "length": 11,
              "width": 2,
              "color": "#EFE6CF"
            },
            {
              "type": "labels",
              "scale": "dial",
              "every": 30,
              "from": 0,
              "to": 330,
              "radius": 72,
              "size": 22,
              "color": "#EFE6CF",
              "orient": "radial",
              "texts": {
                "0": "N",
                "30": "3",
                "60": "6",
                "90": "E",
                "120": "12",
                "150": "15",
                "180": "S",
                "210": "21",
                "240": "24",
                "270": "W",
                "300": "30",
                "330": "33"
              }
            }
          ]
        },
        {
          "type": "ticks",
          "scale": "dial",
          "every": 45,
          "from": 45,
          "to": 315,
          "radius": 106,
          "length": 8,
          "width": 9,
          "color": "#E0D3A8",
          "shape": "triangle"
        },
        {
          "type": "ticks",
          "scale": "dial",
          "at": [
            0
          ],
          "radius": 107,
          "length": 13,
          "width": 14,
          "color": "#E0D3A8",
          "shape": "triangle"
        },
        {
          "type": "needle",
          "scale": "dial",
          "value": "adf2_needle",
          "style": "doubleArrow",
          "length": 88,
          "tail": 76,
          "width": 1.8,
          "color": "#EFE6CF",
          "shadow": true
        },
        {
          "type": "needle",
          "scale": "dial",
          "value": "adf1_needle",
          "style": "arrow",
          "length": 92,
          "tail": 80,
          "width": 2,
          "color": "#EFE6CF",
          "shadow": true
        },
        {
          "type": "hub",
          "r": 7,
          "fill": "#1A1A1A",
          "stroke": "#5A5A5A"
        }
      ]
    },
    {
      "type": "glare",
      "r": 100,
      "opacity": 0.16
    },
    {
      "type": "text",
      "text": "\u003C ADF 1",
      "x": 4,
      "y": 236,
      "size": 10,
      "color": "#EFE6CF",
      "align": "left"
    },
    {
      "type": "text",
      "text": "ADF 2 \u003E\u003E",
      "x": 316,
      "y": 236,
      "size": 10,
      "color": "#EFE6CF",
      "align": "right"
    }
  ]
}
