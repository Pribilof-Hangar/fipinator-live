{
  "format": 1,
  "name": "Classic single Clock",
  "author": "FIPinator 3000",
  "description": "Panel clock showing the sim\u0027s local time.",
  "canvas": {
    "width": 320,
    "height": 240,
    "background": "#8D908E"
  },
  "center": [
    160,
    120
  ],
  "font": "../../../assets/fonts/BarlowCondensed-Medium.ttf",
  "values": {
    "t": {
      "sim": "LOCAL TIME",
      "unit": "seconds",
      "default": 36925
    },
    "h": {
      "expr": "t / 3600 % 12"
    },
    "m": {
      "expr": "t / 60 % 60"
    },
    "s": {
      "expr": "t % 60"
    }
  },
  "scales": {
    "hr": {
      "min": 0,
      "max": 12,
      "startAngle": 0,
      "endAngle": 360,
      "wrap": true
    },
    "min": {
      "min": 0,
      "max": 60,
      "startAngle": 0,
      "endAngle": 360,
      "wrap": true
    }
  },
  "layers": [
    {
      "type": "screw",
      "x": 58,
      "y": 18,
      "kind": "steel"
    },
    {
      "type": "screw",
      "x": 262,
      "y": 18,
      "kind": "steel"
    },
    {
      "type": "screw",
      "x": 58,
      "y": 222,
      "kind": "steel"
    },
    {
      "type": "screw",
      "x": 262,
      "y": 222,
      "kind": "steel"
    },
    {
      "type": "circle",
      "r": 114,
      "fill": "#40000000"
    },
    {
      "type": "circle",
      "r": 112,
      "fillTop": "#3B3C3D",
      "fillBottom": "#050505"
    },
    {
      "type": "circle",
      "r": 101,
      "fillTop": "#1E1E1E",
      "fillBottom": "#060606",
      "stroke": "#000000",
      "strokeWidth": 2
    },
    {
      "type": "circle",
      "r": 103,
      "stroke": "#994A4B4C",
      "strokeWidth": 1
    },
    {
      "type": "ticks",
      "scale": "min",
      "every": 1,
      "from": 0,
      "to": 59,
      "radius": 92.96,
      "length": 6,
      "width": 1.3,
      "color": "#EFE6CF"
    },
    {
      "type": "ticks",
      "scale": "min",
      "every": 5,
      "from": 0,
      "to": 55,
      "radius": 92.96,
      "length": 14,
      "width": 3,
      "color": "#EFE6CF"
    },
    {
      "type": "labels",
      "scale": "hr",
      "every": 1,
      "from": 1,
      "to": 12,
      "radius": 71.5,
      "size": 22,
      "color": "#EFE6CF"
    },
    {
      "type": "text",
      "text": "LOCAL TIME",
      "x": 160,
      "y": 157.54,
      "size": 9,
      "color": "#EFE6CF"
    },
    {
      "type": "needle",
      "scale": "hr",
      "value": "h",
      "length": 46.48,
      "tail": 10.73,
      "width": 5,
      "color": "#F4F2EC",
      "tailColor": "#F4F2EC",
      "shadow": true
    },
    {
      "type": "needle",
      "scale": "min",
      "value": "m",
      "length": 76.87,
      "tail": 12.51,
      "width": 3.6,
      "color": "#F4F2EC",
      "tailColor": "#F4F2EC",
      "shadow": true
    },
    {
      "type": "needle",
      "scale": "min",
      "value": "s",
      "length": 84.02,
      "tail": 17.88,
      "width": 1.3,
      "color": "#D3362B",
      "tailColor": "#D3362B",
      "shadow": true
    },
    {
      "type": "circle",
      "r": 6,
      "fill": "#1A1A1A",
      "stroke": "#555555"
    },
    {
      "type": "circle",
      "r": 1.98,
      "fill": "#777777"
    },
    {
      "type": "glare",
      "r": 100,
      "opacity": 0.16
    }
  ],
  "license": "FREE and open source (AGPL-3.0): free to use, change, share and fork."
}
