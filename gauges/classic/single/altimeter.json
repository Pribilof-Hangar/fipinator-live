{
  "format": 1,
  "name": "Classic single Altimeter",
  "author": "FIPinator 3000",
  "license": "FREE and open source (AGPL-3.0): free to use, change, share and fork.",
  "description": "Three-hand altimeter in DC-6 style: long hand 100 ft per digit (1000 ft per turn), wide hand 1000 ft per digit, thin hand 10,000 ft per digit, and a pressure window in inches of mercury.",
  "canvas": {
    "width": 320,
    "height": 240,
    "background": "#8D908E"
  },
  "center": [
    160,
    120
  ],
  "font": "../../../assets/fonts/BarlowCondensed-Medium.ttf",
  "values": {
    "alt": {
      "sim": "INDICATED ALTITUDE",
      "unit": "feet",
      "default": 7350
    },
    "baro": {
      "sim": "KOHLSMAN SETTING HG",
      "unit": "inHg",
      "default": 29.92
    }
  },
  "scales": {
    "h100": {
      "min": 0,
      "max": 1000,
      "startAngle": 0,
      "endAngle": 360,
      "wrap": true
    },
    "h1000": {
      "min": 0,
      "max": 10000,
      "startAngle": 0,
      "endAngle": 360,
      "wrap": true
    },
    "h10000": {
      "min": 0,
      "max": 100000,
      "startAngle": 0,
      "endAngle": 360,
      "wrap": true
    }
  },
  "controls": {
    "rightKnobClockwise": {
      "event": "KOHLSMAN_INC"
    },
    "rightKnobAnticlockwise": {
      "event": "KOHLSMAN_DEC"
    },
    "leftKnobClockwise": {
      "event": "KOHLSMAN_INC",
      "repeat": 10
    },
    "leftKnobAnticlockwise": {
      "event": "KOHLSMAN_DEC",
      "repeat": 10
    }
  },
  "layers": [
    {
      "type": "screw",
      "x": 58,
      "y": 18,
      "kind": "steel"
    },
    {
      "type": "screw",
      "x": 262,
      "y": 18,
      "kind": "steel"
    },
    {
      "type": "screw",
      "x": 58,
